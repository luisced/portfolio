{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Luis Cedillo's Portfolio Website",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:v4",
    "dev:v4": "pnpm --dir portfolio-v4 dev",
    "build:v4": "pnpm --dir portfolio-v4 build",
    "check:v4": "pnpm --dir portfolio-v4 check",
    "install:v4": "pnpm --dir portfolio-v4 install",
    "dev:v2": "cd portfolio-v2 && npm run dev",
    "build:v2": "cd portfolio-v2 && npm run build",
    "install:v2": "cd portfolio-v2 && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisced/portfolio.git"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "vite"
  ],
  "author": "Luis Cedillo Maldonado",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/luisced/portfolio/issues"
  },
  "homepage": "https://github.com/luisced/portfolio#readme",
  "dependencies": {
    "focus-trap-react": "^11.0.3",
    "framer-motion": "^12.9.2",
    "i18next": "^25.0.1",
    "i18next-browser-languagedetector": "^8.0.5",
    "react-hook-form": "^7.56.1",
    "react-i18next": "^15.5.1"
  }
}
