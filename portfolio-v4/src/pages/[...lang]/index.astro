---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import Work from '@/components/sections/Work.astro';
import Recognition from '@/components/sections/Recognition.astro';
import Timeline from '@/components/sections/Timeline.astro';
import About from '@/components/sections/About.astro';
import Notes from '@/components/sections/Notes.astro';
import Contact from '@/components/sections/Contact.astro';
import { localeStaticPaths } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} path="/">
  <Hero locale={locale} />
  <Work locale={locale} />
  <Recognition locale={locale} />
  <Timeline locale={locale} />
  <About locale={locale} />
  <Notes locale={locale} />
  <Contact locale={locale} />
</Base>
