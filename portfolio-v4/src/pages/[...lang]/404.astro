---
import Base from '@/layouts/Base.astro';
import { localeStaticPaths, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} path="/404/" title={t('notFound.title')} bare>
  <section class="container section nf">
    <p class="kicker">404</p>
    <h1 class="display nf__title">{t('notFound.title')}</h1>
    <p class="muted measure">{t('notFound.body')}</p>
    <a class="btn btn--primary" href={localizePath(locale, '/')}>{t('notFound.home')}</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
    display: grid;
    align-content: center;
    gap: var(--s-4);
  }

  .nf__title {
    font-size: var(--text-3xl);
  }

  .nf .btn {
    justify-self: start;
    margin-top: var(--s-4);
  }
</style>
