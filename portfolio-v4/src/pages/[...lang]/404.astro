---
import Base from '@/layouts/Base.astro';
import { localeStaticPaths, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} path="/404/" title={t('notFound.title')} bare>
  <section class="section container">
    <p class="label">404</p>
    <h1>{t('notFound.title')}</h1>
    <p class="muted">{t('notFound.body')}</p>
    <p><a class="btn btn--primary" href={localizePath(locale, '/')}>{t('notFound.home')}</a></p>
  </section>
</Base>
