---
import Base from '@/layouts/Base.astro';
import { localeStaticPaths, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} path="/404/" title={t('notFound.title')} bare>
  <section class="nf">
    <p class="nf__code display stroke" aria-hidden="true">404</p>
    <div class="nf__body container">
      <h1 class="display nf__title">{t('notFound.title')}</h1>
      <p class="nf__text">{t('notFound.body')}</p>
      <a class="btn btn--acid" href={localizePath(locale, '/')} data-cursor-target>{t('notFound.home')} →</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: var(--s-6);
    overflow: clip;
  }

  .nf__code {
    font-size: clamp(10rem, 40vw, 36rem);
    line-height: 0.8;
    margin-left: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-2);
  }

  .nf__body {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .nf__title {
    font-size: var(--text-2xl);
  }

  .nf__text {
    color: var(--fg-2);
    max-width: 40ch;
  }
</style>
