---
import Base from '@/layouts/Base.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { localeStaticPaths, localizePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale; }
const { locale } = Astro.props;
const es = locale === 'es';
---
<Base locale={locale} title={es ? 'Currículum' : 'Resume'} path="/resume/" bare>
  <section class="document-viewer" data-pdf-viewer data-pdf-status="loading" data-locale={locale} data-viewer-path={localizePath(locale, '/resume/')}>
    <header class="pdf-toolbar">
      <a class="icon-button back-link" href={localizePath(locale, '/')} aria-label={es ? 'Volver al portafolio' : 'Back to portfolio'} title={es ? 'Volver al portafolio' : 'Back to portfolio'}><ArrowIcon direction="left" /></a>
      <div class="document-title"><h1><span>Luis</span><strong>Cedillo</strong></h1><p class="label">CV / PDF</p></div>
      <a class="btn btn--primary download-button" href="/resumee.pdf" download="Luis-Cedillo-CV.pdf" aria-label={es ? 'Descargar CV en PDF' : 'Download resume PDF'}>
        <span>{es ? 'Descargar' : 'Download'}</span>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="share-button" type="button" data-share aria-label={es ? 'Compartir currículum' : 'Share resume'} title={es ? 'Compartir' : 'Share'}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 15V3m-4 4 4-4 4 4M7 10H5v11h14V10h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{es ? 'Compartir' : 'Share'}</span>
      </button>
    </header>
    <p class="pdf-message" data-message role="status" aria-live="polite">{es ? 'Cargando currículum…' : 'Loading resume…'}</p>
    <p class="share-feedback label" data-share-message role="status" aria-live="polite"></p>
    <noscript><p class="pdf-message">{es ? 'Activa JavaScript para usar el visor. También puedes descargar el PDF o abrir el archivo original abajo.' : 'Enable JavaScript to use the viewer. You can also download the PDF or open the original file below.'}</p></noscript>
    <div class="document-stage">
      <div data-pdf-pane tabindex="0" role="region" aria-label={es ? 'Currículum PDF, desplazable' : 'Resume PDF, scrollable'}></div>
      <div class="page-navigation" data-page-nav hidden role="group" aria-label={es ? 'Páginas del documento' : 'Document pages'}>
        <button class="icon-button" type="button" data-prev disabled aria-label={es ? 'Página anterior' : 'Previous page'}><ArrowIcon direction="left" /></button>
        <output data-page>{es ? 'Página' : 'Page'} 1 / …</output>
        <button class="icon-button" type="button" data-next disabled aria-label={es ? 'Página siguiente' : 'Next page'}><ArrowIcon direction="right" /></button>
      </div>
    </div>
    <div class="document-options">
      <a class="text-link original-file" href="/resumee.pdf" target="_blank" rel="noopener">{es ? 'Abrir PDF original' : 'Open original PDF'} <ArrowIcon /></a>
      <details class="pdf-text" hidden data-text-panel><summary><span>{es ? 'Versión de texto' : 'Text version'}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h16" stroke="currentColor" stroke-width="1.5"/><path class="summary-stem" d="M12 4v16" stroke="currentColor" stroke-width="1.5"/></svg></summary><div data-pdf-text></div></details>
    </div>
    <div class="zoom-controls label" data-zoom-controls role="group" aria-label={es ? 'Zoom del documento' : 'Document zoom'}>
      <button type="button" data-zoom-out disabled aria-label={es ? 'Reducir zoom' : 'Zoom out'}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h16" stroke="currentColor" stroke-width="1.5"/></svg></button>
      <output data-zoom aria-label="Zoom">100%</output>
      <button type="button" data-zoom-in disabled aria-label={es ? 'Ampliar zoom' : 'Zoom in'}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h16M12 4v16" stroke="currentColor" stroke-width="1.5"/></svg></button>
      <button class="fit-button" type="button" data-fit disabled>{es ? 'Ajustar' : 'Fit width'}</button>
    </div>
  </section>
  <script>
    import '@/scripts/resume';
  </script>
</Base>
<style>
  .document-viewer { min-height: 100svh; background: var(--bg); padding-bottom: calc(6.5rem + env(safe-area-inset-bottom, 0px)); }
  .pdf-toolbar { position: sticky; top: .75rem; z-index: 5; display: grid; grid-template-columns: 44px minmax(0, 1fr) auto auto; align-items: stretch; gap: 0; width: min(calc(100% - 2 * var(--gutter)), var(--container)); min-height: 54px; margin: .75rem auto 0; border: 1px solid var(--line); background: var(--bg); }
  .icon-button, .share-button, .zoom-controls button { appearance: none; -webkit-appearance: none; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border: 0; border-radius: 0; background: transparent; color: var(--fg); text-decoration: none; font-family: var(--font-mono); touch-action: manipulation; }
  .back-link { font-size: 18px; }
  .back-link:hover, .share-button:hover { background: var(--pink); color: #171717; }
  .document-title { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: .5rem .6rem; border-left: 1px solid var(--line); }
  .document-title h1 { display: flex; align-items: baseline; gap: .25em; font-size: clamp(.875rem, 3.8vw, 1.05rem); line-height: 1; letter-spacing: -.065em; font-weight: 400; white-space: nowrap; }
  .document-title h1 strong { position: relative; font-weight: 750; letter-spacing: -.08em; }
  .document-title h1 strong::after { content: ''; position: absolute; right: 0; bottom: -.16em; left: .08em; height: .08em; background: var(--pink); transform: skewX(-18deg); }
  .document-title p { margin-top: .5rem; font-size: .55rem; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pdf-toolbar .download-button { min-height: 52px; padding: .7rem .8rem; gap: .65rem; align-self: stretch; border-top: 0; border-bottom: 0; border-right: 0; }
  .share-button { gap: .6rem; min-height: 52px; border-left: 1px solid var(--line); padding: .6rem .75rem; font-size: .6rem; text-transform: uppercase; }
  .share-button span { display: none; }
  .pdf-message { max-width: 54rem; margin-inline: auto; padding: 10px 16px; font-size: var(--text-sm); color: var(--fg-2); }
  .pdf-message:empty, .share-feedback:empty { display: none; }
  .share-feedback { position: fixed; z-index: 8; bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px)); left: 50%; transform: translateX(-50%); width: max-content; max-width: calc(100% - 32px); background: var(--bg); color: var(--fg); border: 1px solid var(--line); padding: .75rem 1rem; text-align: center; }
  .document-stage { padding-top: 14px; }
  [data-pdf-pane] { width: min(100%, 54rem); margin-inline: auto; overflow: auto; padding: 8px; overscroll-behavior-x: contain; min-height: 10rem; }
  [data-pdf-pane] :global(canvas) { display: block; margin-inline: auto; background: white; outline: 1px solid var(--line); }
  .page-navigation { display: flex; justify-content: center; align-items: center; gap: 16px; margin: 12px auto; font: .65rem var(--font-mono); color: var(--fg-3); }
  .page-navigation button:disabled { opacity: .35; }
  .document-options { width: min(calc(100% - 2 * var(--gutter)), 52rem); margin: 12px auto 0; color: var(--fg-2); font-size: var(--text-sm); }
  .original-file { color: var(--fg-3); }
  .pdf-text { margin-top: 8px; border-top: 1px solid var(--line); }
  .pdf-text summary { display: flex; align-items: center; justify-content: space-between; min-height: 48px; cursor: pointer; list-style: none; font: .65rem var(--font-mono); text-transform: uppercase; }
  .pdf-text summary::-webkit-details-marker { display: none; }
  .pdf-text[open] .summary-stem { display: none; }
  [data-pdf-text] { padding: 8px 0 20px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 15px; line-height: 1.7; }
  .zoom-controls { position: fixed; z-index: 6; left: 50%; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; align-items: stretch; padding: 0; border: 1px solid var(--line); border-radius: 0; background: var(--bg); color: var(--fg); box-shadow: none; }
  .zoom-controls button { border-left: 1px solid var(--line); font-size: .65rem; padding: .5rem; }
  .zoom-controls button:first-child { border-left: 0; }
  .zoom-controls button:hover:not(:disabled) { background: var(--pink); color: #171717; }
  .zoom-controls button:disabled { opacity: .4; cursor: default; }
  .zoom-controls output { display: grid; place-items: center; width: 52px; border-left: 1px solid var(--line); font: .65rem var(--font-mono); font-variant-numeric: tabular-nums; }
  .zoom-controls .fit-button { min-width: 82px; padding-inline: 12px; text-transform: uppercase; }
  @media (--sm) { .share-button span { display: inline; } }
  @media (--md) {
    .pdf-toolbar { top: 1.25rem; margin-top: 1.25rem; min-height: 64px; }
    .document-title { padding-inline: 1rem; }
    .document-title h1 { font-size: 1.2rem; }
    .document-stage { padding-top: 20px; }
    .zoom-controls { top: calc(1.25rem + 9px); bottom: auto; }
  }
</style>
