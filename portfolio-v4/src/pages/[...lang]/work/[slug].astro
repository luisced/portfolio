---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import {
  getProjects,
  localizePath,
  useTranslations,
  type Project,
} from '@/i18n/utils';
import { locales, type Locale } from '@/i18n/ui';
import { breadcrumbs, projectWork } from '@/lib/seo';

interface Props {
  project: Project;
  locale: Locale;
}

export async function getStaticPaths() {
  const paths = [];

  for (const locale of locales) {
    const projects = await getProjects(locale);
    paths.push(
      ...projects.map((project) => ({
        params: {
          lang: locale === 'en' ? undefined : 'es',
          slug: project.data.slug,
        },
        props: { project, locale },
      })),
    );
  }

  return paths;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const categoryLabel = t(`work.category.${project.data.category}`);
const projects = await getProjects(locale);
const currentIndex = projects.findIndex((entry) => entry.data.slug === project.data.slug);

if (currentIndex < 0) {
  throw new Error(`Project not found: ${project.data.slug}`);
}

const previousProject = projects[(currentIndex + projects.length - 1) % projects.length];
const nextProject = projects[(currentIndex + 1) % projects.length];

if (!previousProject || !nextProject) {
  throw new Error(`Project navigation is unavailable: ${project.data.slug}`);
}

const previousPath = localizePath(locale, `/work/${previousProject.data.slug}/`);
const nextPath = localizePath(locale, `/work/${nextProject.data.slug}/`);
const { Content } = await render(project);
---

<Base
  locale={locale}
  title={project.data.title}
  description={project.data.outcome}
  path={`/work/${project.data.slug}/`}
  type="article"
  ogImage={`/og/work/${project.data.slug}.png`}
  jsonLd={[
    projectWork(project, locale),
    breadcrumbs(locale, [
      { name: 'Luis Cedillo', path: '/' },
      { name: t('work.all'), path: '/work/' },
      { name: project.data.title, path: `/work/${project.data.slug}/` },
    ]),
  ]}
>
  <article class="section container">
    <p class="label"><a href={localizePath(locale, '/work/')}>{t('work.all')}</a> / {categoryLabel} / {project.data.timeframe} · {currentIndex + 1} / {projects.length}</p>
    <h1>{project.data.title}</h1>
    <p class="measure muted" style="font-size: var(--text-lg)">{project.data.outcome}</p>

    <Picture fallbackFormat="webp" src={project.data.gallery[0]?.src ?? project.data.cover} alt={project.data.gallery[0]?.alt ?? project.data.coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 48em) 65vw, 90vw" formats={['avif', 'webp']} loading="eager" decoding="async" />

    <dl>
      <dt class="label">{t('work.role')}</dt><dd>{project.data.role}</dd>
      <dt class="label">{t('work.timeframe')}</dt><dd>{project.data.timeframe}</dd>
      <dt class="label">{t('work.stack')}</dt><dd>{project.data.stack.map((s) => <span class="chip">{s}</span>)}</dd>
      {(project.data.links.live || project.data.links.repo) && (
        <>
          <dt class="label">Links</dt>
          <dd>
            {project.data.links.live && <a class="btn btn--primary" href={project.data.links.live} rel="noopener" target="_blank">{t('work.live')} ↗</a>}
            {project.data.links.repo && <a class="btn" href={project.data.links.repo} rel="noopener" target="_blank">{t('work.repo')} ↗</a>}
          </dd>
        </>
      )}
    </dl>

    <div class="prose">
      <Content />
    </div>

    {project.data.gallery.length > 0 && (
      <ol class="list">
        {project.data.gallery.map((image) => (
          <li>
            <figure>
              <Picture fallbackFormat="webp" src={image.src} alt={image.alt} widths={[480, 960]} sizes="(min-width: 48em) 50vw, 100vw" formats={['avif', 'webp']} loading="lazy" />
              <figcaption class="label">{image.alt}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    )}

    <nav aria-label={t('work.next')}>
      <a href={previousPath}>← {t('work.prev')}: {previousProject.data.title}</a> ·
      <a href={nextPath}>{t('work.next')}: {nextProject.data.title} →</a>
    </nav>
  </article>
</Base>
