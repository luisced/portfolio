---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { getProjects, localeStaticPaths, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<Base locale={locale} title={t('work.all')} description={t('work.description')} path="/work/">
  <section class="section container" aria-labelledby="work-index-title">
    <h1 id="work-index-title">{t('work.all')}</h1>
    <ol class="list">
      {projects.map((p) => (
        <li>
          <a href={localizePath(locale, `/work/${p.data.slug}/`)}>
            <Picture fallbackFormat="webp" src={p.data.cover} alt={p.data.coverAlt} widths={[480, 960]} sizes="(min-width: 48em) 40rem, 100vw" formats={['avif', 'webp']} loading="lazy" />
            <h2>{p.data.title}</h2>
          </a>
          <p class="muted">{p.data.outcome}</p>
          <p class="label">{p.data.role} · {t(`work.category.${p.data.category}`)} · {p.data.timeframe}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>
