---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import {
  formatDate,
  localizePath,
  readingMinutes,
  useTranslations,
} from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import type { Note } from '@/i18n/utils';

interface Props {
  note: Note;
  locale: Locale;
}

export async function getStaticPaths() {
  const notes = await getCollection('notes', (entry) => !entry.data.draft);

  return notes.map((note) => {
    const locale = note.data.locale;
    return {
      params: {
        lang: locale === 'en' ? undefined : 'es',
        slug: note.data.slug,
      },
      props: { note, locale },
    };
  });
}

const { note, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(note);
const published = note.data.date.toISOString();
---

<Base
  locale={locale}
  title={note.data.title}
  description={note.data.summary}
  path={`/notes/${note.data.slug}/`}
  type="article"
  ogImage={`/og/notes/${note.data.slug}.png`}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
  </Fragment>

  <article class="note-article section">
    <div class="container">
      <a class="note-back mono" href={localizePath(locale, '/notes/')}>
        <span aria-hidden="true">←</span> {t('notes.back')}
      </a>

      <header class="article-head" data-reveal>
        <div class="article-kicker kicker">
          <time datetime={published}>{formatDate(locale, note.data.date, { month: 'short' })}</time>
          <span>{readingMinutes(note.body)} {t('notes.readingTime')}</span>
          {note.data.tags.length > 0 && (
            <ul class="article-tags">
              {note.data.tags.map((tag) => <li class="article-tag mono">{tag}</li>)}
            </ul>
          )}
        </div>
        <h1 class="display">{note.data.title}</h1>
        <p class="article-summary">{note.data.summary}</p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .note-article {
    padding-block-start: var(--s-7);
  }

  .note-back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: 44px;
    color: var(--fg-2);
    font-size: var(--text-xs);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: var(--s-1);
  }

  .note-back span {
    color: var(--amber);
    font-size: var(--text-md);
  }

  .article-head {
    display: grid;
    gap: var(--s-5);
    max-inline-size: var(--measure);
    margin-block: var(--s-8) var(--s-9);
    margin-inline: auto;
  }

  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    color: var(--fg-2);
  }

  .article-kicker > span:not(.article-tag) {
    white-space: nowrap;
  }

  .article-kicker > span::before {
    margin-inline-end: var(--s-3);
    color: var(--fg-3);
    content: '·';
  }

  .article-head h1 {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .article-summary {
    color: var(--fg-2);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .article-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: var(--s-1) var(--s-2);
    color: var(--fg-2);
    font-size: var(--text-xs);
    font-weight: 400;
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: var(--bg-3);
  }

  .article-tag::before {
    inline-size: var(--s-2);
    block-size: var(--s-2);
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent-brand);
    content: '';
  }

  .article-tag:nth-child(2)::before { background: var(--accent-amber); }
  .article-tag:nth-child(3)::before { background: var(--accent-rose); }
  .article-tag:nth-child(4)::before { background: var(--accent-sky); }
  .article-tag:nth-child(5)::before { background: var(--accent-violet); }

  .prose {
    max-inline-size: var(--measure);
    margin-inline: auto;
  }

  :global(.prose p),
  :global(.prose li) {
    color: var(--fg-2);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  :global(.prose p + p),
  :global(.prose ul + p),
  :global(.prose ol + p) {
    margin-block-start: var(--s-5);
  }

  :global(.prose strong) {
    color: var(--fg);
    font-weight: 600;
  }

  :global(.prose h2) {
    margin-block: var(--s-8) var(--s-4);
    padding-block-end: var(--s-2);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-snug);
    text-transform: uppercase;
    border-block-end: 1px solid var(--amber);
  }

  :global(.prose h3) {
    margin-block: var(--s-6) var(--s-3);
    color: var(--fg);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  :global(.prose ul),
  :global(.prose ol) {
    display: grid;
    gap: var(--s-2);
    padding-inline-start: var(--s-5);
    margin-block: var(--s-5);
  }

  :global(.prose ul li::marker) {
    color: var(--brand);
  }

  :global(.prose a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-underline-offset: var(--s-1);
  }

  :global(.prose blockquote) {
    padding-inline-start: var(--s-5);
    margin-block: var(--s-6);
    color: var(--fg-2);
    border-inline-start: 3px solid var(--brand);
  }

  :global(.prose pre) {
    overflow-x: auto;
    padding: var(--s-4);
    margin-block: var(--s-6);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    box-shadow: var(--shadow-1);
  }

  :global(.prose pre code) {
    padding: 0;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: transparent;
    border: 0;
  }

  :global(.prose :not(pre) > code) {
    padding: var(--s-1) var(--s-2);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
  }

  :global(.prose hr) {
    margin-block: var(--s-7);
    border: 0;
    border-block-start: 1px solid var(--line);
  }

  @media (--md) {
    .note-article {
      padding-block-start: var(--s-8);
    }

    .article-head {
      margin-block-start: var(--s-9);
    }
  }
</style>
