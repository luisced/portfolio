---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import {
  formatDate,
  localizePath,
  readingMinutes,
  useTranslations,
} from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import type { Note } from '@/i18n/utils';
import { blogPosting, breadcrumbs } from '@/lib/seo';

interface Props {
  note: Note;
  locale: Locale;
}

export async function getStaticPaths() {
  const notes = await getCollection('notes', (entry) => !entry.data.draft);

  return notes.map((note) => {
    const locale = note.data.locale;
    return {
      params: {
        lang: locale === 'en' ? undefined : 'es',
        slug: note.data.slug,
      },
      props: { note, locale },
    };
  });
}

const { note, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(note);
const published = note.data.date.toISOString();
---

<Base
  locale={locale}
  title={note.data.title}
  description={note.data.summary}
  path={`/notes/${note.data.slug}/`}
  type="article"
  ogImage={`/og/notes/${note.data.slug}.png`}
  jsonLd={[
    blogPosting(note, locale, (note.body ?? '').trim().split(/\s+/).filter(Boolean).length),
    breadcrumbs(locale, [
      { name: 'Luis Cedillo', path: '/' },
      { name: t('notes.all'), path: '/notes/' },
      { name: note.data.title, path: `/notes/${note.data.slug}/` },
    ]),
  ]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
  </Fragment>

  <article class="section container">
    <p class="label"><a href={localizePath(locale, '/notes/')}>{t('notes.back')}</a> · <time datetime={published}>{formatDate(locale, note.data.date, { month: 'short' })}</time> · {readingMinutes(note.body)} {t('notes.readingTime')} · {note.data.tags.join(', ')}</p>
    <h1>{note.data.title}</h1>
    <p class="measure muted" style="font-size: var(--text-lg)">{note.data.summary}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
