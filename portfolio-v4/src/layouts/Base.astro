---
import '@/styles/base.css';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { localizePath, otherLocale, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Site-relative path without locale prefix, e.g. "/work/upocket/". */
  path?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  /** Hide nav/footer chrome (404 etc.). */
  bare?: boolean;
}

const {
  locale,
  path = '/',
  title,
  description,
  ogImage,
  type = 'website',
  bare = false,
} = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ? `${title} — Luis Cedillo` : t('site.title');
const pageDescription = description ?? t('site.description');
const site = Astro.site!;
const canonical = new URL(localizePath(locale, path), site);
const alt = otherLocale(locale);
const altUrl = new URL(localizePath(alt, path), site);
const og = new URL(ogImage ?? '/og/default.png', site);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alt} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath('en', path), site)} />
    <link rel="alternate" type="application/rss+xml" title="Luis Cedillo — notes" href={new URL(localizePath(locale, '/rss.xml'), site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={serifUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={serifItalicUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#211f1b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f3ee" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Luis Cedillo" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:locale:alternate" content={alt === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={og} />
    <slot name="head" />
    <script is:inline>
      // No-flash theme + JS marker. Runs before first paint.
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersLight = matchMedia('(prefers-color-scheme: light)').matches;
        const theme = stored === 'light' || stored === 'dark' ? stored : prefersLight ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip.main')}</a>
    <div class="atmosphere" aria-hidden="true"></div>
    {!bare && <Nav locale={locale} path={path} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
    <script>
      import '@/scripts/theme';
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        // Motion (and GSAP) only ever loads when motion is welcome, and only after
        // the page is idle so it never competes with the hero for bandwidth or CPU.
        const load = () => import('@/scripts/motion');
        const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 1500 }) : setTimeout(load, 200));
        if (document.readyState === 'complete') idle();
        else addEventListener('load', idle, { once: true });
      } else {
        for (const el of document.querySelectorAll('[data-reveal]')) el.classList.add('is-visible');
      }
    </script>
  </body>
</html>

<style is:global>
  main {
    position: relative;
    z-index: 1;
  }

  main:focus {
    outline: none;
  }
</style>
