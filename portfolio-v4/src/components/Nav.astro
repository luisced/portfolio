---
import { getProfile, localizePath, otherLocale, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const home = localizePath(locale, '/');
const alt = otherLocale(locale);
const [firstName, ...lastName] = profile.data.shortName.split(' ');
---
<header class="site-header">
  <div class="nav container">
    <a class="wordmark" href={home}><span class="wordmark-full"><span>{firstName}</span><strong>{lastName.join(' ')}</strong></span></a>
    <nav class="primary" aria-label={locale === 'es' ? 'Navegación principal' : 'Primary navigation'}>
      <a href={`${home}#work`}>{t('nav.work')}</a><a href={`${home}#about`}>{t('nav.about')}</a><a href={localizePath(locale, '/notes/')}>{t('nav.notes')}</a><a class="nav-contact" href={`${home}#contact`}>{t('nav.contact')} <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="utilities"><a href={localizePath(alt, path)} hreflang={alt} lang={alt}>{t('lang.code')}<span class="sr-only"> · {t('lang.switch')}</span></a><button type="button" data-theme-toggle aria-label={t('theme.toggle')} title={t('theme.toggle')}><svg class="theme-icon" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><circle class="theme-icon-core" cx="10" cy="10" r="3"/><path class="theme-icon-rays" d="M10 1.5v3M10 15.5v3M1.5 10h3M15.5 10h3M4 4l2.1 2.1M13.9 13.9 16 16M16 4l-2.1 2.1M6.1 13.9 4 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path class="theme-icon-moon" d="M14.7 3.9a6.8 6.8 0 1 0 1.4 12.9A7.2 7.2 0 0 1 14.7 3.9Z" fill="currentColor"/></svg></button></div>
  </div>
  <div class="reading-progress" aria-hidden="true"></div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  let compact = false;
  const syncHeader = () => {
    const next = scrollY > 72;
    if (!header || next === compact) return;
    compact = next;
    header.toggleAttribute('data-compact', compact);
  };
  syncHeader();
  addEventListener('scroll', syncHeader, { passive: true });
  if (import.meta.hot) import.meta.hot.dispose(() => removeEventListener('scroll', syncHeader));
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; padding-top: .75rem; background: var(--bg); transition: padding .24s ease; }
  .nav { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: stretch; min-height: 3.75rem; border: 1px solid var(--line); transition: min-height .24s ease; }
  a { text-decoration: none; }
  .wordmark { grid-column: 1; grid-row: 1; display: flex; min-width: 0; align-items: baseline; gap: .75rem; padding: .5rem .7rem; font-size: clamp(1.05rem, 5vw, 1.35rem); font-weight: 400; letter-spacing: -.065em; line-height: 1; transition: font-size .24s ease; }
  .wordmark-full { display: inline-flex; align-items: baseline; gap: .28em; white-space: nowrap; }
  .wordmark-full strong { position: relative; font-weight: 750; letter-spacing: -.08em; }
  .wordmark-full strong::after { content: ''; position: absolute; right: 0; bottom: -.16em; left: .08em; height: .08em; background: var(--pink); transform: skewX(-18deg); }
  .primary { grid-column: 1 / -1; grid-row: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-height: 2.85rem; overflow: hidden; border-top: 1px solid var(--line); opacity: 1; font: .55rem var(--font-mono); text-transform: uppercase; transition: max-height .24s ease, opacity .18s ease, border-color .24s ease; }
  .primary a { display: flex; min-width: 0; min-height: 2.85rem; align-items: center; justify-content: center; gap: .4rem; padding-inline: .35rem; border-left: 1px solid var(--line); }
  .primary a:first-child { border-left: 0; }
  .primary a:hover, .utilities a:hover, button:hover { color: #171717; background: var(--pink); }
  .utilities { grid-column: 2; grid-row: 1; display: flex; align-items: stretch; font: .6rem var(--font-mono); }
  .utilities a, button { display: grid; place-items: center; min-width: 2.65rem; min-height: 3.75rem; border: 0; border-left: 1px solid var(--line); padding: .4rem; background: none; }
  .nav-contact { display: none !important; }
  .theme-icon { overflow: visible; }
  .theme-icon-core, .theme-icon-rays, .theme-icon-moon { transition: opacity .35s ease, transform .35s ease; transform-origin: 10px 10px; }
  .theme-icon-moon { opacity: 0; transform: translate(2px, -2px) scale(.65); }
  :global([data-theme='dark']) .theme-icon-core,
  :global([data-theme='dark']) .theme-icon-rays { opacity: 0; transform: scale(.65) rotate(35deg); }
  :global([data-theme='dark']) .theme-icon-moon { opacity: 1; transform: none; }
  .reading-progress { height: 2px; background: var(--fg); position: absolute; bottom: 0; left: var(--gutter); right: var(--gutter); transform: scaleX(0); transform-origin: left; }
  .site-header[data-compact] { padding-top: .3rem; }
  .site-header[data-compact] .nav { min-height: 3rem; }
  .site-header[data-compact] .wordmark { font-size: 1rem; }
  .site-header[data-compact] .primary { max-height: 0; border-top-color: transparent; opacity: 0; pointer-events: none; }
  .site-header[data-compact] .utilities a,
  .site-header[data-compact] button { min-height: 3rem; }
  @media (--md) { .site-header, .site-header[data-compact] { padding-top: 1.25rem; } .nav, .site-header[data-compact] .nav { display: flex; min-height: 4rem; } .wordmark, .site-header[data-compact] .wordmark { padding-inline: 1.25rem; margin-right: auto; font-size: clamp(1.1rem, 2.2vw, 1.65rem); } .primary, .site-header[data-compact] .primary { display: flex; max-height: none; overflow: visible; border-top: 0; opacity: 1; pointer-events: auto; font-size: .65rem; } .primary a, .primary a:first-child { min-height: auto; padding-inline: 1.5rem; border-left: 1px solid var(--line); } .nav-contact { display: flex !important; background: var(--fg); color: var(--bg); } .utilities a, button, .site-header[data-compact] .utilities a, .site-header[data-compact] button { min-width: 3rem; min-height: auto; } }
  @media (--motion-reduce) { .site-header, .nav, .wordmark, .primary, .utilities a, button { transition: none; } }
</style>
