---
import { getProfile, localizePath, otherLocale, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const home = localizePath(locale, '/');
const alt = otherLocale(locale);
---

<header class="nav container">
  <a href={home}><strong>{profile.data.shortName}</strong></a>
  <nav aria-label="Primary">
    <a href={`${home}#work`}>{t('nav.work')}</a>
    <a href={`${home}#about`}>{t('nav.about')}</a>
    <a href={localizePath(locale, '/notes/')}>{t('nav.notes')}</a>
    <a href={`${home}#contact`}>{t('nav.contact')}</a>
    <a href={localizePath(alt, path)} hreflang={alt} lang={alt}>{t('lang.code')}<span class="sr-only"> · {t('lang.switch')}</span></a>
    <button type="button" data-theme-toggle aria-label={t('theme.toggle')} title="Alt+T">◐</button>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-4);
  }

  .nav a {
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: center;
  }

  button {
    background: none;
    border: 1px solid var(--line);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }
</style>
