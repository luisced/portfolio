---
import { getProfile, localizePath, otherLocale, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const home = localizePath(locale, '/');
const alt = otherLocale(locale);
const links = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: localizePath(locale, '/notes/'), label: t('nav.notes') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="nav" data-nav>
  <div class="nav__row cells">
    <a class="nav__brand cell" href={home}>
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="narrow narrow--bold">Luis Cedillo</span>
      <span class="label nav__rev">Rev 4.0</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul class="cells">
        {links.map((l) => (
          <li><a class="cell narrow" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <ul class="nav__social cells">
      {profile.data.socials.slice(0, 2).map((s) => (
        <li><a class="cell narrow" href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>
      ))}
    </ul>

    <a class="nav__tool cell narrow" href={localizePath(alt, path)} hreflang={alt} lang={alt}>
      {t('lang.code')}<span class="sr-only"> · {t('lang.switch')}</span>
    </a>
    <button class="nav__tool nav__theme cell" type="button" data-theme-toggle aria-label={t('theme.toggle')} title="Alt+T">
      <span class="nav__swatch" aria-hidden="true"></span>
    </button>
    <button class="nav__tool nav__burger cell" type="button" aria-expanded="false" aria-controls="nav-sheet" aria-label={t('nav.menu')} data-nav-toggle>
      <span></span><span></span>
    </button>
  </div>

  <div class="nav__sheet" id="nav-sheet" hidden>
    <ul class="cells">
      {links.map((l, i) => (
        <li><a class="cell headline" href={l.href}><span class="label">0{i + 1}</span>{l.label}</a></li>
      ))}
      {profile.data.socials.map((s) => (
        <li><a class="cell narrow" href={s.url} rel="me noopener" target="_blank">{s.label} ↗</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = document.getElementById('nav-sheet');
  if (nav && toggle && sheet) {
    const close = () => {
      sheet.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const open = sheet.hidden;
      sheet.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) sheet.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !sheet.hidden) {
        close();
        toggle.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--bg);
  }

  .nav__row {
    grid-template-columns: 1fr auto auto auto;
    border-inline: 0;
    border-top: 0;
  }

  .nav__row > * {
    display: flex;
    align-items: center;
  }

  .nav__brand {
    gap: var(--s-3);
    font-size: var(--text-md);
  }

  .nav__mark {
    width: 12px;
    height: 12px;
    background: var(--brand);
  }

  .nav__rev {
    color: var(--fg-3);
    display: none;
  }

  .nav__row > .nav__links,
  .nav__row > .nav__social {
    display: none;
    padding: 0;
    list-style: none;
  }

  .nav__links ul,
  .nav__social {
    padding: 0;
    grid-auto-flow: column;
    border: 0;
    border-inline: var(--hair) solid var(--line);
  }

  .nav__links li,
  .nav__social li {
    display: flex;
  }

  .nav__links a,
  .nav__social a {
    height: 100%;
    display: inline-flex;
    align-items: center;
    padding-inline: var(--s-5);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    transition:
      background-color var(--d-1) var(--ease-step),
      color var(--d-1) var(--ease-step);
  }

  .nav__links a:hover,
  .nav__social a:hover,
  .nav__tool:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .nav__tool {
    justify-content: center;
    min-width: 3.5rem;
    padding-inline: var(--s-3);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    transition:
      background-color var(--d-1) var(--ease-step),
      color var(--d-1) var(--ease-step);
  }

  .nav__swatch {
    width: 14px;
    height: 14px;
    border: var(--hair) solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  /* `.nav__row > *` outranks a lone class under Astro scoping; qualify the burger. */
  .nav__row > .nav__burger {
    display: inline-grid;
    gap: 5px;
    align-content: center;
  }

  .nav__burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform var(--d-2) var(--ease-out);
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .nav__sheet .cells {
    padding: 0;
    list-style: none;
    border-inline: 0;
    border-top: 0;
  }

  .nav__sheet li {
    display: flex;
  }

  .nav__sheet a {
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    font-size: var(--text-2xl);
    padding-block: var(--s-4);
  }

  .nav__sheet a.narrow {
    font-size: var(--text-md);
  }

  .nav__sheet a:hover {
    background: var(--fg);
    color: var(--bg);
  }

  @media (--md) {
    .nav__row {
      grid-template-columns: 1fr auto auto auto auto;
    }

    .nav__rev {
      display: inline;
    }

    .nav__row > .nav__links {
      display: block;
    }

    .nav__row > .nav__burger,
    .nav__sheet {
      display: none;
    }
  }

  @media (--lg) {
    .nav__row {
      grid-template-columns: 1fr auto auto auto auto auto;
    }

    .nav__row > .nav__social {
      display: grid;
    }
  }
</style>
