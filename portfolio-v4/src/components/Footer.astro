---
import { getProfile, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const home = localizePath(locale, '/');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="mono footer__brand">luis<span class="footer__dot">.</span>cedillo</p>
      <p class="muted footer__built">{t('footer.built')}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer__links">
        <li><a class="mono" href={`${home}#work`}>{t('nav.work')}</a></li>
        <li><a class="mono" href={`${home}#about`}>{t('nav.about')}</a></li>
        <li><a class="mono" href={localizePath(locale, '/notes/')}>{t('nav.notes')}</a></li>
        <li><a class="mono" href={`${home}#contact`}>{t('nav.contact')}</a></li>
        <li><a class="mono" href={localizePath(locale, '/rss.xml')}>{t('footer.rss')}</a></li>
      </ul>
    </nav>
    <ul class="footer__links footer__social">
      {profile.data.socials.map((s) => (
        <li><a class="mono" href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>
      ))}
      <li><a class="mono" href={`mailto:${profile.data.email}`}>{profile.data.email}</a></li>
    </ul>
  </div>
  <div class="container footer__legal">
    <p class="mono muted">© {year} {profile.data.name}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line-2);
    background: var(--bg-2);
    padding-block: var(--s-8) var(--s-6);
    font-size: var(--text-sm);
  }

  .footer__grid {
    display: grid;
    gap: var(--s-6);
  }

  .footer__brand {
    font-size: var(--text-md);
  }

  .footer__dot {
    color: var(--brand);
  }

  .footer__built {
    margin-top: var(--s-2);
    font-size: var(--text-xs);
  }

  .footer__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
  }

  .footer__links a {
    text-decoration: none;
    color: var(--fg-2);
  }

  .footer__links a:hover {
    color: var(--fg);
  }

  .footer__legal {
    margin-top: var(--s-7);
    font-size: var(--text-xs);
  }

  @media (--md) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }

    .footer__links {
      flex-direction: column;
    }
  }
</style>
