---
import ManifestoIsland from '@/components/islands/ManifestoIsland';
import { getProfile, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const quote = profile.data.manifesto[locale];
---

<section id="manifesto" class="section manifesto" aria-labelledby="manifesto-title">
  <p class="label manifesto__kicker container" id="manifesto-title">{t('manifesto.kicker')}</p>
  <div class="container">
    <ManifestoIsland client:visible text={quote} />
    <noscript><p class="manifesto__text display">{quote}</p></noscript>
  </div>
</section>

<style is:global>
  .manifesto {
    padding-block: var(--s-9) var(--s-10);
  }

  .manifesto__kicker {
    color: var(--acid);
    margin-bottom: var(--s-6);
  }

  .manifesto__float.scroll-float {
    overflow: visible;
  }

  .manifesto__text.scroll-float-text,
  .manifesto__text {
    display: block;
    font-size: var(--text-2xl);
    font-weight: 800;
    font-variation-settings: 'wdth' 105;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-align: left;
    text-transform: uppercase;
    max-width: 22ch;
  }

  .manifesto__text .char {
    will-change: transform, opacity;
  }
</style>
