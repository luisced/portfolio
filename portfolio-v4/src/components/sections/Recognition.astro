---
import { Picture } from 'astro:assets';
import { getProfile, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const { data: profile } = await getProfile();
const kinds = ['award', 'publication', 'credential'] as const;
---
<section id="recognition" class="section" aria-labelledby="recognition-title">
  <div class="container">
    <div class="recognition-intro">
      <div>
        <p class="label section-label">{t('recognition.kicker')}</p>
        <h2 id="recognition-title">{t('recognition.title')}</h2>
      </div>
      <p class="intro-copy">{t('recognition.intro')}</p>
    </div>
    {kinds.map((kind) => (
      <div class:list={['recognition-group', kind]}>
        <h3 class="label group-title">{t(`recognition.${kind}`)}</h3>
        <ul class="recognition-list">
          {profile.recognition.filter((entry) => entry.kind === kind).map((entry) => (
            <li class="recognition-record" data-reveal>
              <div class="record-heading">
                {entry.media[0] && (
                  <figure class="record-cover">
                    <a href={entry.media[0].source} target="_blank" rel="noopener noreferrer">
                      <Picture src={entry.media[0].src} alt={entry.media[0].alt[locale]}
                        width={Math.min(entry.media[0].src.width, kind === 'award' ? 960 : 480)}
                        widths={kind === 'award' ? [360, 640, 960] : [240, 480]}
                        sizes={kind === 'award' ? '(min-width: 48em) 45vw, 90vw' : '240px'}
                        formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" />
                    </a>
                    <figcaption>{entry.media[0].caption[locale]} <span aria-hidden="true">↗</span></figcaption>
                  </figure>
                )}
                <p class="distinction">{entry.distinction[locale]}</p>
                <h4>{entry.title[locale]}</h4>
                <p class="record-context">{entry.context[locale]}</p>
              </div>
              <div class="record-body">
                <p>{entry.summary[locale]}</p>
                {entry.details[locale].length > 0 && (
                  <details>
                    <summary>{t('recognition.details')}<span aria-hidden="true">+</span></summary>
                    <ul>{entry.details[locale].map((detail) => <li>{detail}</li>)}</ul>
                    {entry.media.length > 1 && (
                      <div class="project-screens">
                        {entry.media.slice(1).map((media) => (
                          <figure>
                            <a href={media.source} target="_blank" rel="noopener noreferrer">
                              <Picture src={media.src} alt={media.alt[locale]} widths={[160, 221]} sizes="(min-width: 48em) 160px, 38vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" />
                            </a>
                            <figcaption>{media.caption[locale]} <span aria-hidden="true">↗</span></figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                  </details>
                )}
                <ul class="source-links">
                  {entry.links.map((link) => (
                    <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]} <span aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<style>
  .recognition-intro { display: grid; gap: 1.5rem; margin-bottom: 3rem; }
  h2 { white-space: pre-line; font-size: clamp(1.875rem, 5vw, 5.25rem); }
  .intro-copy { color: var(--fg-2); max-width: 36ch; align-self: end; }
  .recognition-group + .recognition-group { margin-top: 3.5rem; }
  .group-title { margin-bottom: 1.25rem; }
  .recognition-list, .source-links { list-style: none; padding: 0; }
  .recognition-list { display: grid; column-gap: 3rem; }
  .recognition-record { min-width: 0; border-top: 1px solid var(--line); padding-block: 1.75rem; }
  .record-cover { margin: 0 0 1.5rem; }
  .record-cover > a { display: block; background: var(--bg-2); border: 1px solid var(--line); }
  .record-cover :global(img) { display: block; width: 100%; height: auto; }
  .award .record-cover :global(img) { aspect-ratio: 4 / 3; object-fit: contain; }
  .credential .record-cover { max-width: 15rem; }
  .credential .record-cover > a { background: #fff; }
  .credential .record-cover :global(img) { aspect-ratio: 672 / 352; object-fit: contain; }
  .publication .record-cover { max-width: 9.5rem; }
  figcaption { margin-top: .5rem; font-size: .65rem; line-height: 1.5; color: var(--fg-2); }
  .project-screens { display: grid; grid-template-columns: repeat(2, minmax(0, 10rem)); gap: 1rem; margin-block: 1rem; }
  .project-screens figure { min-width: 0; margin: 0; }
  .project-screens a { display: block; }
  .project-screens :global(img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .distinction { font-size: .8rem; font-weight: 600; margin-bottom: .75rem; }
  .award .distinction { font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.1; letter-spacing: -.04em; max-width: 15ch; }
  h4 { font-size: 1.25rem; line-height: 1.3; max-width: 40ch; }
  .publication h4 { font-size: clamp(1.3rem, 2vw, 1.65rem); }
  .record-context { font-size: .75rem; color: var(--fg-2); margin-top: .75rem; }
  .record-body { margin-top: 1.25rem; font-size: .9rem; color: var(--fg-2); }
  .record-body > p { max-width: 65ch; }
  details { margin-top: 1rem; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; padding-block: .5rem; cursor: pointer; color: var(--fg); list-style: none; font-size: .8rem; }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 1.2rem; }
  details[open] summary span { transform: rotate(45deg); }
  details ul { padding: .5rem 0 .5rem 1rem; }
  details li + li { margin-top: .75rem; }
  .source-links { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; margin-top: 1rem; font-size: .75rem; color: var(--fg); }
  .source-links a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; text-underline-offset: .25em; }
  @media (--md) {
    .recognition-intro { grid-template-columns: 1.5fr 1fr; gap: 3rem; }
    .award .recognition-list, .credential .recognition-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .publication .recognition-record { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
    .publication .record-body { margin-top: 0; }
  }
</style>
