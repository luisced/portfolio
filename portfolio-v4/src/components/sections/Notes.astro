---
import { formatDate, getNotes, localizePath, readingMinutes, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const notes = (await getNotes(locale)).slice(0, 3);
---
<section id="notes" class="section" aria-labelledby="notes-title">
  <div class="container">
    <p class="label section-label">{t('notes.kicker')}</p><h2 id="notes-title">{t('notes.title')}</h2>
    {notes.length === 0 ? <p class="muted">{t('notes.empty')}</p> : <ul class="notes-list">{notes.map((n, i) => <li data-reveal><span class="note-number label">0{i + 1}</span><div><p class="label">{formatDate(locale, n.data.date, { month: 'short' })} · {readingMinutes(n.body)} {t('notes.readingTime')}</p><h3><a href={localizePath(locale, `/notes/${n.data.slug}/`)}>{n.data.title}</a></h3><p class="muted">{n.data.summary}</p></div><span class="note-arrow" aria-hidden="true">↗</span></li>)}</ul>}
    <a class="text-link" href={localizePath(locale, '/notes/')}>{t('notes.all')} <span aria-hidden="true">↗</span></a>
  </div>
</section>
<style>
  .notes-list { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  li { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; padding: 1.5rem; border: 1px solid var(--line); }
  .note-number { grid-column: 1 / -1; border-bottom: 1px solid var(--line); padding-bottom: .75rem; }
  h3 { margin-block: 1rem; max-width: 24ch; font-size: clamp(1.8rem, 3vw, 3rem); }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  li:hover h3 { color: var(--accent); }
  li .muted { max-width: 65ch; font-size: .95rem; }
  .note-arrow { font-size: 2rem; }
  .text-link { margin-top: 1rem; }
  @media (--md) { .notes-list { grid-template-columns: 1fr 1fr; } li { padding: 2rem; } .note-arrow { justify-self: end; } }
</style>
