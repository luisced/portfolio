---
import { formatDate, getNotes, localizePath, readingMinutes, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const notes = (await getNotes(locale)).slice(0, 3);
---

<section id="notes" class="section" aria-labelledby="notes-title">
  <div class="container">
    <p class="label">{t('notes.kicker')}</p>
    <h2 id="notes-title">{t('notes.title')}</h2>
    {notes.length === 0 ? (
      <p class="muted">{t('notes.empty')}</p>
    ) : (
      <ul class="list">
        {notes.map((n) => (
          <li>
            <p class="label">{formatDate(locale, n.data.date, { month: 'short' })} · {readingMinutes(n.body)} {t('notes.readingTime')}</p>
            <h3><a href={localizePath(locale, `/notes/${n.data.slug}/`)}>{n.data.title}</a></h3>
            <p class="muted">{n.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
    <p><a href={localizePath(locale, '/notes/')}>{t('notes.all')} →</a></p>
  </div>
</section>
