---
import { getProfile, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const p = profile.data;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container contact-layout">
    <div class="contact-intro">
      <p class="label section-label">{t('contact.kicker')}</p>
      <h2 id="contact-title">{t('contact.title')}</h2>
      <p class="measure muted">{t('contact.lead')}</p>
      <a class="contact-email" href={`mailto:${p.email}`}>{p.email}<span aria-hidden="true">↗</span></a>
    </div>

    <div class="contact-panel">
      <div class="contact__note">
        <form class="contact__form" method="post" action="/api/contact" data-contact data-sending={t('contact.sending')} data-msg-required={t('contact.required')} data-msg-email={t('contact.invalidEmail')} data-msg-minlength={t('contact.invalidMessage')} data-msg-rate-limit={t('contact.rateLimit')} novalidate>
          <div class="field">
            <label class="label" for="contact-name">{t('contact.name')}</label>
            <input id="contact-name" name="name" type="text" required maxlength="100" autocomplete="name" aria-describedby="contact-name-error" />
            <p class="field__error" id="contact-name-error" aria-live="polite" hidden></p>
          </div>
          <div class="field">
            <label class="label" for="contact-email">{t('contact.email')}</label>
            <input id="contact-email" name="email" type="email" required maxlength="254" autocomplete="email" aria-describedby="contact-email-error" />
            <p class="field__error" id="contact-email-error" aria-live="polite" hidden></p>
          </div>
          <div class="field">
            <label class="label" for="contact-message">{t('contact.message')} <span class="field__count" data-message-count>0 / 5000</span></label>
            <textarea id="contact-message" name="message" rows="6" required minlength="20" maxlength="5000" aria-describedby="contact-message-error"></textarea>
            <p class="field__error" id="contact-message-error" aria-live="polite" hidden></p>
          </div>
          <input class="sr-only" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="locale" value={locale} />
          {siteKey && <fieldset class="contact__verification">
            <legend class="sr-only">{t('contact.turnstile')}</legend>
            <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-size="flexible"></div>
          </fieldset>}
          <div class="contact__status" role="status" aria-live="polite" data-contact-status hidden></div>
          <button class="btn btn--primary" type="submit" data-contact-submit>{t('contact.send')} <span aria-hidden="true">→</span></button>
        </form>

        <div class="contact__result contact__result--success" role="status" tabindex="-1" data-contact-success hidden>
          <p class="label">✓ {t('contact.success.title')}</p>
          <h3>{t('contact.success.title')}</h3>
          <p>{t('contact.success.body')}</p>
        </div>
        <div class="contact__result contact__result--error" role="alert" tabindex="-1" data-contact-error hidden>
          <p class="label">! {t('contact.error.title')}</p>
          <h3>{t('contact.error.title')}</h3>
          <p data-contact-error-default>{t('contact.error.body')}{' '}<a href={`mailto:${p.email}`}>{p.email}</a>.</p>
          <p data-contact-error-rate-limit hidden>{t('contact.rateLimit')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '@/scripts/contact';
</script>

<style>
  #contact { background: #171717; --bg: #171717; --bg-2: #242424; --fg: #f7f7f2; --fg-2: #d1d1c9; --fg-3: #aaaaa1; --line: #53534e; --accent: #f5a6c2; --danger: #ffa094; color: var(--fg); }

  .contact-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .contact-intro {
    min-width: 0;
  }

  h2 { white-space: pre-line; font-size: clamp(3.5rem, 10vw, 10rem); max-width: 14ch; font-weight: 600; line-height: .95; }
  .contact-email { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: clamp(1.4rem, 4vw, 4rem); letter-spacing: -.04em; text-decoration: none; padding-block: 2rem; margin-block: 1rem 0; border-bottom: 1px solid var(--fg-3); }
  .contact-email:hover { color: var(--accent); }

  .contact-panel {
    position: relative;
    align-self: start;
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-left: .45rem solid var(--accent);
    background: var(--bg-2);
    overflow: hidden;
  }

  .contact-panel::after {
    content: '→';
    position: absolute;
    top: -1.5rem;
    right: -.5rem;
    color: var(--line);
    font-family: var(--font-display);
    font-size: 5.5rem;
    line-height: 1;
    pointer-events: none;
  }

  .contact__note { position: relative; margin-block: 0; }
  .contact__form {
    display: grid;
    gap: var(--s-5);
    counter-reset: field;
  }
  .field { min-width: 0; }
  .field .label {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    color: var(--fg-2);
    font-size: .65rem;
    margin-bottom: .5rem;
  }
  .field .label::before {
    counter-increment: field;
    content: counter(field, decimal-leading-zero);
    color: var(--accent);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: .75rem .1rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid #6a6a62;
    border-radius: 0;
    color: var(--fg);
    transition: border-color .2s ease, background-color .2s ease;
  }
  .field textarea { min-height: 8rem; resize: vertical; }
  .field input:hover,
  .field textarea:hover { border-color: var(--fg-3); }
  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--accent);
    background: rgba(255,255,255,.045);
  }
  .field__count { margin-left: auto; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--danger);
    background: rgba(255, 160, 148, .07);
  }
  .field__error {
    margin: .45rem 0 0;
    color: var(--danger);
    font: .65rem/1.4 var(--font-mono);
  }
  .contact__form > .btn span { transition: transform .2s ease; }
  .contact__form > .btn:hover span { transform: translateX(.25rem); }
  .contact__form > .btn:disabled { cursor: wait; opacity: .72; }

  .contact__status {
    grid-column: 1 / -1;
    padding: .75rem 1rem;
    border: 1px solid var(--line);
    color: var(--fg-2);
    font: .7rem/1.4 var(--font-mono);
    text-transform: uppercase;
  }

  .contact__result {
    display: grid;
    gap: 1rem;
    outline: none;
  }
  .contact__result--success {
    min-height: 22rem;
    align-content: center;
  }
  .contact__result .label { color: var(--accent); }
  .contact__result h3 {
    max-width: 10ch;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    line-height: .95;
    letter-spacing: -.055em;
  }
  .contact__result p:not(.label) { max-width: 36ch; color: var(--fg-2); }
  .contact__result--error {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--danger);
  }
  .contact__result--error .label { color: var(--danger); }
  .contact__result--error h3 { max-width: 16ch; font-size: clamp(1.75rem, 3vw, 2.75rem); }
  .contact__result a { color: var(--fg); }


  .contact__verification {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .contact__verification:empty {
    display: none;
  }
  @media (--md) { .contact__form { grid-template-columns: 1fr 1fr; gap: 1.5rem; } .field:nth-child(3), .contact__verification { grid-column: 1 / -1; } .contact__form > .btn { grid-column: 1 / -1; width: fit-content; } }
  @media (--lg) {
    #contact { padding-block: 8rem; }
    h2 { font-size: clamp(3.5rem, 6vw, 6rem); }
    .contact-layout { grid-template-columns: minmax(0, 5fr) minmax(22rem, 4fr); gap: 4rem; align-items: start; }
    .contact-email { font-size: clamp(1.4rem, 3vw, 3.25rem); padding-block: 1rem; margin-block: .5rem 0; }
    .contact__form textarea { min-height: 7rem; }
  }
</style>
