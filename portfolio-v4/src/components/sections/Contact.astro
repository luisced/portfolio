---
import ContactHeading from '@/components/islands/ContactHeading';
import { getProfile, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const p = profile.data;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const wa = p.whatsapp.replace(/[^\d]/g, '');
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <header class="chapter">
    <span class="chapter__num">05</span>
    <h2 id="contact-title" class="display chapter__title">{t('contact.title')}</h2>
    <span class="label chapter__meta">{t('contact.kicker')}</span>
  </header>

  <div class="contact__lead container">
    <ContactHeading client:media="(prefers-reduced-motion: no-preference)" text={t('contact.lead')} />
    <noscript><p class="contact__scramble display">{t('contact.lead')}</p></noscript>
  </div>

  <div class="contact__grid">
    <div class="contact__note">
      <form method="post" action="/api/contact" data-contact data-sending={t('contact.sending')} data-msg-required={t('contact.required')} data-msg-email={t('contact.invalidEmail')} data-msg-message={t('contact.invalidMessage')} novalidate>
        <div class="field">
          <label class="label" for="contact-name">{t('contact.name')}</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" aria-describedby="contact-name-error" />
          <p class="field__error mono" id="contact-name-error" hidden></p>
        </div>
        <div class="field">
          <label class="label" for="contact-email">{t('contact.email')}</label>
          <input id="contact-email" name="email" type="email" required autocomplete="email" aria-describedby="contact-email-error" />
          <p class="field__error mono" id="contact-email-error" hidden></p>
        </div>
        <div class="field">
          <label class="label" for="contact-message">{t('contact.message')}</label>
          <textarea id="contact-message" name="message" rows="6" required minlength="20" aria-describedby="contact-message-error"></textarea>
          <p class="field__error mono" id="contact-message-error" hidden></p>
        </div>

        <input class="sr-only" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="locale" value={locale} />

        <fieldset class="contact__verification">
          <legend class="sr-only">{t('contact.turnstile')}</legend>
          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-size="flexible"></div>
        </fieldset>

        <button class="btn btn--acid contact__submit" type="submit" data-contact-submit data-cursor-target>{t('contact.send')} →</button>
      </form>

      <div class="sr-only" role="status" aria-live="polite" tabindex="-1" data-contact-status></div>

      <div class="contact__state" data-contact-success hidden>
        <h3 class="display">{t('contact.success.title')}</h3>
        <p>{t('contact.success.body')}</p>
      </div>
      <div class="contact__state contact__state--error" data-contact-error hidden>
        <h3 class="display">{t('contact.error.title')}</h3>
        <p>{t('contact.error.body')}{' '}<a href={`mailto:${p.email}`}>{p.email}</a>.</p>
      </div>
    </div>

    <aside class="contact__direct" aria-label={t('contact.direct')}>
      <p class="label">{t('contact.direct')}</p>
      <ul class="rows contact__links">
        <li><span class="mono contact__k">@</span><a href={`mailto:${p.email}`} data-cursor-target>{p.email}</a><span class="label">Email</span></li>
        <li><span class="mono contact__k">#</span><a href={`https://wa.me/${wa}`} rel="noopener" target="_blank" data-cursor-target>{t('contact.whatsapp')}</a><span class="label">{p.whatsapp}</span></li>
        {p.socials.map((s) => (
          <li><span class="mono contact__k">↗</span><a href={s.url} rel="me noopener" target="_blank" data-cursor-target>{s.label}</a><span class="label">{s.handle}</span></li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<script>
  import '@/scripts/contact';
</script>

<style is:global>
  .contact__lead {
    padding-block: var(--s-7) var(--s-6);
  }

  .contact__scramble.text-block {
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'wdth' 105;
    color: var(--fg);
    font-size: var(--text-2xl);
    max-width: 24ch;
    text-transform: none;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }

  .contact__scramble .word {
    display: inline-block;
    white-space: nowrap;
  }

  .contact__grid {
    display: grid;
    border-top: var(--hair) solid var(--line);
  }

  .contact__note {
    padding: var(--s-6) var(--gutter) var(--s-8);
    border-bottom: var(--hair) solid var(--line);
  }

  .contact__note form {
    display: grid;
    gap: var(--s-5);
    max-width: 40rem;
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }

  .field .label {
    color: var(--fg-3);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: var(--s-3) 0;
    background: transparent;
    border: 0;
    border-bottom: var(--hair) solid var(--line);
    font-size: var(--text-lg);
    color: var(--fg);
    outline: none;
  }

  .field input:focus,
  .field textarea:focus {
    border-bottom-color: var(--acid);
  }

  .field [aria-invalid='true'] {
    border-bottom-color: var(--danger);
  }

  .field__error {
    color: var(--danger);
    font-size: var(--text-xs);
  }

  .field__error[hidden] {
    display: none;
  }

  .contact__verification {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .contact__verification:empty {
    display: none;
  }

  .contact__submit {
    justify-self: start;
    min-height: 3.5rem;
    padding-inline: var(--s-6);
  }

  .contact__state:not([hidden]) {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-6);
    padding: var(--s-5);
    border: var(--hair) solid var(--acid);
    max-width: 40rem;
  }

  .contact__state h3 {
    font-size: var(--text-xl);
    color: var(--acid);
  }

  .contact__state--error:not([hidden]) {
    border-color: var(--danger);
  }

  .contact__state--error h3 {
    color: var(--danger);
  }

  .contact__state a {
    text-decoration: underline;
    text-decoration-color: var(--acid);
  }

  .contact__direct {
    padding: var(--s-6) var(--gutter) var(--s-8);
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .contact__direct > .label {
    color: var(--acid);
  }

  .contact__links a {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .contact__links a:hover {
    color: var(--acid);
  }

  .contact__k {
    color: var(--fg-3);
  }

  @media (--md) {
    .contact__grid {
      grid-template-columns: 1.3fr 0.7fr;
    }

    .contact__note {
      border-bottom: 0;
      border-right: var(--hair) solid var(--line);
    }
  }
</style>
