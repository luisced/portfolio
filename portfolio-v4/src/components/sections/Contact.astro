---
import { getProfile, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const p = profile.data;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const wa = p.whatsapp.replace(/[^\d]/g, '');
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <p class="label section-label">{t('contact.kicker')}</p>
    <h2 id="contact-title">{t('contact.title')}</h2>
    <p class="measure muted">{t('contact.lead')}</p>
    <a class="contact-email" href={`mailto:${p.email}`}>{p.email}<span aria-hidden="true">↗</span></a>

    <div class="contact__note">
      <form class="contact__form" method="post" action="/api/contact" data-contact data-sending={t('contact.sending')} data-msg-required={t('contact.required')} data-msg-email={t('contact.invalidEmail')} data-msg-minlength={t('contact.invalidMessage')} novalidate>
        <div class="field">
          <label class="label" for="contact-name">{t('contact.name')}</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" aria-describedby="contact-name-error" />
          <p class="field__error" id="contact-name-error" hidden></p>
        </div>
        <div class="field">
          <label class="label" for="contact-email">{t('contact.email')}</label>
          <input id="contact-email" name="email" type="email" required autocomplete="email" aria-describedby="contact-email-error" />
          <p class="field__error" id="contact-email-error" hidden></p>
        </div>
        <div class="field">
          <label class="label" for="contact-message">{t('contact.message')}</label>
          <textarea id="contact-message" name="message" rows="6" required minlength="20" aria-describedby="contact-message-error"></textarea>
          <p class="field__error" id="contact-message-error" hidden></p>
        </div>
        <input class="sr-only" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="locale" value={locale} />
        {siteKey && <fieldset class="contact__verification">
          <legend class="sr-only">{t('contact.turnstile')}</legend>
          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-size="flexible"></div>
        </fieldset>}
        <button class="btn btn--primary" type="submit" data-contact-submit>{t('contact.send')}</button>
      </form>

      <div class="sr-only" role="status" aria-live="polite" tabindex="-1" data-contact-status></div>
      <div data-contact-success hidden>
        <h3>{t('contact.success.title')}</h3>
        <p>{t('contact.success.body')}</p>
      </div>
      <div data-contact-error hidden>
        <h3>{t('contact.error.title')}</h3>
        <p>{t('contact.error.body')}{' '}<a href={`mailto:${p.email}`}>{p.email}</a>.</p>
      </div>
    </div>

    <p class="label">{t('contact.direct')}</p>
    <ul>
      <li><a href={`https://wa.me/${wa}`} rel="noopener" target="_blank">{t('contact.whatsapp')}</a></li>
      {p.socials.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
</section>

<script>
  import '@/scripts/contact';
</script>

<style>
  #contact { background: #171717; --bg: #171717; --bg-2: #242424; --fg: #f7f7f2; --fg-2: #d1d1c9; --fg-3: #aaaaa1; --line: #53534e; --accent: #f5a6c2; --danger: #ffa094; color: var(--fg); }
  h2 { white-space: pre-line; font-size: clamp(3.5rem, 10vw, 10rem); max-width: 14ch; font-weight: 600; line-height: .95; }
  .contact-email { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: clamp(1.4rem, 4vw, 4rem); letter-spacing: -.04em; text-decoration: none; padding-block: 2rem; margin-block: 1rem 2rem; border-bottom: 1px solid var(--fg-3); }
  .contact-email:hover { color: var(--accent); }
  ul { display: flex; flex-wrap: wrap; gap: 1rem 2rem; list-style: none; padding: 0; margin-top: .5rem; }
  ul a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: .875rem; }
  .contact__note { margin-block: 2rem; }
  .contact__form {
    display: grid;
    gap: var(--s-4);
    max-width: 58rem;
    margin-block: var(--s-5);
  }

  .contact__verification {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .contact__verification:empty {
    display: none;
  }
  @media (--md) { .contact__form { grid-template-columns: 1fr 1fr; gap: 1.5rem; } .field:nth-child(3), .contact__verification { grid-column: 1 / -1; } .contact__form > .btn { width: fit-content; } }
</style>
