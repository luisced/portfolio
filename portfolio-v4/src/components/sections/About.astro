---
import { Picture } from 'astro:assets';
import { getProfile, getProjects, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const p = profile.data;
const titles = new Map((await getProjects(locale)).map((x) => [x.data.slug, x.data.title]));
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <p class="label">{t('about.kicker')}</p>
    <h2 id="about-title">{t('about.title')}</h2>
    <Picture fallbackFormat="webp" src={p.portrait} alt={p.portraitAlt[locale]} widths={[400, 800]} sizes="20rem" formats={['avif', 'webp']} loading="lazy" style="max-width: 20rem" />
    <p class="measure">{p.bio[locale]}</p>
    <p class="measure">{p.manifesto[locale]}</p>

    <h3>{t('about.skills')}</h3>
    {p.skills.map((g) => (
      <div>
        <p class="label">{g.group[locale]}</p>
        <ul>
          {g.items.map((i) => (
            <li>
              {i.name}
              {i.evidence.length > 0 && (
                <span class="muted">
                  {' — '}
                  {i.evidence.map((slug, idx) => (
                    <>
                      {idx > 0 && ', '}
                      <a href={localizePath(locale, `/work/${slug}/`)}>{titles.get(slug) ?? slug}</a>
                    </>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <h3>{t('about.education')}</h3>
    <ul>{p.education.map((e) => <li>{e.year} — {e.credential[locale]}, {e.institution}</li>)}</ul>
    <h3>{t('about.languages')}</h3>
    <ul>{p.languages.map((l) => <li>{l.name[locale]} — {l.level[locale]}</li>)}</ul>
    <p><a class="btn" href={p.cv} download>{t('about.cv')}</a></p>
  </div>
</section>
