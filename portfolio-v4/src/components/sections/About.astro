---
import { Picture } from 'astro:assets';
import type { Locale } from '@/i18n/ui';
import { getProfile, getProjects, localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const projects = await getProjects(locale);
const projectTitles = new Map(projects.map((project) => [project.data.slug, project.data.title]));
const bioParts = profile.data.bio[locale].split(/(?<=[.!?])\s+/).filter(Boolean);
const bioLead = bioParts[0] ?? profile.data.bio[locale];
const bioDetails = bioParts.slice(1).join(' ');
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <header class="sec-head" data-reveal>
      <p class="kicker">{t('about.kicker')}</p>
      <h2 class="method" id="about-title">{t('about.title')}<span class="sr-only">: {t('about.kicker')}</span></h2>
    </header>

    <div class="about__grid">
      <div class="about__portrait-column">
        <div class="about__portrait-frame" data-reveal>
          <Picture
            fallbackFormat="webp"
            class="about__portrait"
            src={profile.data.portrait}
            widths={[400, 800]}
            sizes="(min-width: 64rem) 32vw, 100vw"
            formats={['avif', 'webp']}
            alt={profile.data.portraitAlt[locale]}
            loading="lazy"
          />
        </div>
        <p class="about__name mono" data-reveal>{profile.data.name}</p>

        <dl class="plate about__plate" data-reveal>
          <div>
            <dt>{t('about.location')}</dt>
            <dd>{profile.data.location}</dd>
          </div>
          <div>
            <dt>{t('about.timezone')}</dt>
            <dd>{profile.data.timezone}</dd>
          </div>
          <div class="about__availability">
            <dt>{t('about.availability')}</dt>
            <dd><span class="about__status-dot" aria-hidden="true"></span>{profile.data.availability[locale]}</dd>
          </div>
          <div class="about__socials">
            <dt>{t('about.socials')}</dt>
            <dd>
              <ul>
                {profile.data.socials.map((social) => (
                  <li>
                    <a href={social.url} target="_blank" rel="noreferrer">
                      <span>{social.label}</span>
                      <span class="mono">{social.handle}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          <div class="about__cv">
            <dt class="sr-only">{t('about.cv')}</dt>
            <dd>
              <a class="btn" href={profile.data.cv} download>{t('about.cv')}</a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="about__content">
        <div class="about__bio" data-reveal>
          <p class="measure">{bioLead}</p>
          <p class="measure">{bioDetails}</p>
        </div>

        <section class="about__skills" aria-labelledby="about-skills-title" data-reveal>
          <header class="about__section-head">
            <h3 id="about-skills-title" class="about__heading">{t('about.skills')}</h3>
          </header>
          <div class="about__skills-grid">
            {profile.data.skills.map((skillGroup, groupIndex) => (
              <section class="about__skill-group" aria-labelledby={`skill-${groupIndex}`}>
                <h4 class="kicker" id={`skill-${groupIndex}`}>{skillGroup.group[locale]}</h4>
                <ul class="about__skill-list">
                  {skillGroup.items.map((item) => (
                    <li>
                      <span>{item.name}</span>
                      {item.evidence.length > 0 && (
                        <span class="about__evidence">
                          {item.evidence.map((slug) => {
                            const title = projectTitles.get(slug) ?? slug;
                            return (
                              <a class="mono" href={localizePath(locale, `/work/${slug}/`)}>
                                <span class="sr-only">{t('about.evidence')} </span>→ {title}
                              </a>
                            );
                          })}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>

        <div class="about__details" data-reveal>
          <section aria-labelledby="about-education-title">
            <h3 id="about-education-title" class="about__heading">{t('about.education')}</h3>
            <dl class="about__details-list mono">
              {profile.data.education.map((entry) => (
                <div>
                  <dt>{entry.institution}</dt>
                  <dd>{entry.credential[locale]} <span>{entry.year}</span></dd>
                </div>
              ))}
            </dl>
          </section>
          <section aria-labelledby="about-languages-title">
            <h3 id="about-languages-title" class="about__heading">{t('about.languages')}</h3>
            <dl class="about__details-list mono">
              {profile.data.languages.map((language) => (
                <div>
                  <dt>{language.name[locale]}</dt>
                  <dd>{language.level[locale]}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sec-head {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-7);
  }

  .about__grid {
    display: grid;
    gap: var(--s-8);
  }

  .about__portrait-column,
  .about__content {
    display: grid;
    align-content: start;
  }

  .about__portrait-column {
    gap: var(--s-4);
  }

  .about__content {
    gap: var(--s-7);
  }

  .about__name {
    color: var(--fg-2);
    font-size: var(--text-sm);
  }

  .about__portrait-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-4);
    background: var(--bg-2);
    box-shadow: var(--shadow-2);
  }

  .about__portrait-frame :global(picture) {
    display: block;
    height: 100%;
  }

  .about__portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__plate {
    gap: var(--s-4);
  }

  .about__availability dd {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .about__status-dot {
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.3em;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0.2rem color-mix(in oklch, var(--ok) 16%, transparent);
  }

  .about__socials dd ul {
    display: grid;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
  }

  .about__socials a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2);
    min-height: 2.75rem;
    align-items: center;
    color: var(--fg);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .about__socials a .mono {
    color: var(--fg-2);
  }

  .about__cv dd {
    margin-top: var(--s-2);
  }

  .about__bio {
    display: grid;
    gap: var(--s-4);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .about__bio p:first-child {
    color: var(--fg);
  }

  .about__bio p + p {
    color: var(--fg-2);
  }

  .about__section-head {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .about__heading {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .about__skills-grid {
    display: grid;
    align-items: start;
    gap: var(--s-5);
  }

  .about__skill-group {
    display: grid;
    align-content: start;
    gap: var(--s-3);
  }

  /* Engraved spec list: name on the left, evidence trailing in muted mono. */
  .about__skill-list {
    display: grid;
    list-style: none;
    padding: 0;
  }

  .about__skill-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--line-2);
    color: var(--fg);
    font-size: var(--text-sm);
  }

  .about__skill-list li > span:first-child {
    font-weight: 500;
  }

  .about__evidence {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-size: var(--text-xs);
  }

  .about__evidence a {
    color: var(--fg-3);
    text-decoration: none;
    transition: color var(--d-2) var(--ease-out);
  }

  .about__evidence a:hover {
    color: var(--brand);
  }

  .about__details {
    display: grid;
    gap: var(--s-6);
  }

  .about__details > section {
    display: grid;
    gap: var(--s-4);
  }

  .about__details-list {
    display: grid;
    gap: var(--s-4);
    color: var(--fg);
    font-size: var(--text-xs);
  }

  .about__details-list dt {
    color: var(--fg-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about__details-list dd {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-1);
  }

  .about__details-list dd span {
    color: var(--fg-3);
  }

  @media (--md) {
    .about__skills-grid,
    .about__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (--lg) {
    .about__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-9);
    }
  }
</style>
