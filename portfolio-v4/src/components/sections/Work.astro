---
import { getImage } from 'astro:assets';
import WorkIsland, { type WorkPanel } from '@/components/islands/WorkIsland';
import { getProjects, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const featured = (await getProjects(locale)).filter((p) => p.data.featured);
const panels: WorkPanel[] = await Promise.all(
  featured.map(async (p) => {
    const img = await getImage({ src: p.data.cover, width: 1200, format: 'webp' });
    return {
      href: localizePath(locale, `/work/${p.data.slug}/`),
      title: p.data.title,
      role: p.data.role,
      outcome: p.data.outcome,
      category: t(`work.category.${p.data.category}`),
      stack: p.data.stack.slice(0, 5),
      cover: img.src,
      coverAlt: p.data.coverAlt,
    };
  }),
);
---

<section id="work" class="section" aria-labelledby="work-title">
  <header class="chapter">
    <span class="chapter__num">01</span>
    <h2 id="work-title" class="display chapter__title">{t('work.title')}</h2>
    <a class="label chapter__meta" href={localizePath(locale, '/work/')} data-cursor-target>{t('work.all')} →</a>
  </header>

  <WorkIsland client:media="(prefers-reduced-motion: no-preference)" panels={panels} labels={{ view: t('work.view'), role: t('work.role'), stack: t('work.stack'), outcome: t('work.outcome') }} />
</section>

<style is:global>
  .work {
    position: relative;
    overflow: clip;
  }

  .work__progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--line-2);
    z-index: 2;
  }

  .work__bar {
    height: 100%;
    background: var(--acid);
    transform: scaleX(0);
    transform-origin: left;
  }

  .work__track {
    display: grid;
  }

  .panel {
    display: grid;
    gap: var(--s-5);
    padding: var(--s-7) var(--gutter);
    border-bottom: var(--hair) solid var(--line-2);
  }

  .panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .panel__num {
    font-size: var(--text-3xl);
    line-height: 1;
  }

  .panel__cat {
    color: var(--acid);
  }

  .panel__title {
    font-size: var(--text-2xl);
  }

  .panel__glitch.glitch {
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    font-size: inherit;
    line-height: 0.95;
    white-space: normal;
    color: var(--fg);
    margin: 0;
  }

  .panel__glitch.glitch::before,
  .panel__glitch.glitch::after {
    background-color: var(--bg);
    color: var(--fg);
  }

  .panel__glitch.glitch::after {
    text-shadow: var(--after-shadow, -6px 0 #c8ff00);
  }

  .panel__glitch.glitch::before {
    text-shadow: var(--before-shadow, 6px 0 #ff5c7a);
  }

  .panel__body {
    display: grid;
    gap: var(--s-5);
  }

  .panel__art {
    display: block;
  }

  .panel__pixels.pixelated-image-card {
    width: 100%;
    border-radius: 0;
    border: var(--hair) solid var(--line);
    background: var(--bg-2);
  }

  .panel__pixels img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__art-alt {
    height: 100%;
    display: grid;
    align-content: end;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--acid);
    color: var(--acid-ink);
  }

  .panel__art-alt .label {
    color: var(--acid-ink);
  }

  .panel__art-alt p {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .panel__copy {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .panel__outcome {
    font-size: var(--text-lg);
    color: var(--fg-2);
    max-width: 40ch;
  }

  .panel__spec {
    display: grid;
    gap: var(--s-4);
    margin: 0;
  }

  .panel__spec div {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: var(--hair) solid var(--line-2);
  }

  .panel__spec dt {
    color: var(--fg-3);
  }

  .panel__spec dd {
    margin: 0;
  }

  .panel__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .panel__magnet {
    justify-self: start;
  }

  @media (--md) {
    .work__track {
      grid-auto-flow: column;
      grid-auto-columns: 100vw;
      will-change: transform;
    }

    .panel {
      height: 100svh;
      grid-template-rows: auto auto 1fr;
      border-bottom: 0;
      border-right: var(--hair) solid var(--line-2);
      padding-block: var(--s-8) var(--s-7);
    }

    .panel__body {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
    }
  }
</style>
