---
import { Picture } from 'astro:assets';
import { getProjects, localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const featured = (await getProjects(locale)).filter(p => p.data.featured);
---
<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <header class="work-heading"><p class="label section-label">{t('work.kicker')}</p><h2 id="work-title">{t('work.title')}</h2><div class="work-intro"><p>{t('work.intro')}</p><a class="text-link" href={localizePath(locale, '/work/')}>{t('work.all')} <span aria-hidden="true">↗</span></a></div></header>
    <nav class="chapters" aria-label={t('work.kicker')}><a href="#project-dopamina" data-chapter-link aria-current="step"><span>[00]</span> Dopamina <span aria-hidden="true">↗</span></a><a href="#project-iluk" data-chapter-link><span>[01]</span> iLuk <span aria-hidden="true">↗</span></a>{featured.map((p, i) => <a href={`#project-${p.data.slug}`} data-chapter-link><span>[0{i + 2}]</span> {p.data.title.split(' / ')[0]} <span aria-hidden="true">↗</span></a>)}</nav>
    <article id="project-dopamina" class="project project--current" data-chapter>
      <div class="project-top label"><span>[00] / Dopamina</span><span>{t('work.current')}</span></div>
      <div class="project-layout">
        <figure class="system-figure system-figure--dopamina">
          <figcaption class="label">{t('work.dopamina.diagram')}</figcaption>
          <div class="brand-lockup brand-lockup--dopamina"><img src="/brand/dopamina-wordmark.png" alt="Dopamina" width="4096" height="1194" loading="lazy" decoding="async" /><span class="brand-signal" aria-hidden="true">↗</span></div>
          <div class="doppie-swarm" aria-hidden="true"><img class="doppie doppie--reviewer" src="/brand/doppie-reviewer.webp" alt="" width="1254" height="1254" loading="lazy" decoding="async" /><img class="doppie doppie--producer" src="/brand/doppie-producer.webp" alt="" width="1254" height="1254" loading="lazy" decoding="async" /><img class="doppie doppie--creator" src="/brand/doppie-creator.webp" alt="" width="1254" height="1254" loading="lazy" decoding="async" /></div>
          <div class="system-rail" aria-hidden="true">{Array.from({length:6},()=> <span class="rail-dot"></span>)}</div>
          <ol class="system-nodes"><li>{t('work.dopamina.node1')}</li><li>{t('work.dopamina.node2')}</li><li>{t('work.dopamina.node3')}</li><li>{t('work.dopamina.node4')}</li><li>{t('work.dopamina.node5')}</li><li>{t('work.dopamina.node6')}</li></ol>
          <div class="system-human label"><span aria-hidden="true">↳</span> {t('work.dopamina.human')}</div>
        </figure>
        <div class="project-copy"><p class="label project-role">{t('work.dopamina.role')}</p><h3>{t('work.dopamina.title')}</h3><p class="project-description">{t('work.dopamina.body')}</p><p class="project-stack">{['Content Studio', 'Publishing', 'Community', 'Paid Ads'].map((tool) => <span class="chip">{tool}</span>)}</p><a class="btn" href="https://dopamina.media/" target="_blank" rel="noopener">{t('work.dopamina.link')} <span aria-hidden="true">↗</span></a></div>
      </div>
    </article>
    <article id="project-iluk" class="project" data-chapter>
      <div class="project-top label"><span>[01] / iLuk</span><span>{t('work.iluk.badge')}</span></div>
      <div class="project-layout">
        <figure class="system-figure system-figure--iluk">
          <figcaption class="label">{t('work.iluk.diagram')}</figcaption>
          <div class="brand-lockup brand-lockup--iluk"><img src="/brand/iluk-logo.png" alt="iLuk" width="300" height="129" loading="lazy" decoding="async" /><span class="brand-signal" aria-hidden="true">↗</span></div>
          <div class="iluk-agents" aria-hidden="true">
            <div class="iluk-agent"><img src="/brand/iluk-agent-acquire.webp" alt="" width="295" height="342" loading="lazy" decoding="async" /><span>acquire</span></div>
            <div class="iluk-agent iluk-agent--raised"><img src="/brand/iluk-agent-verify.webp" alt="" width="346" height="342" loading="lazy" decoding="async" /><span>verify</span></div>
            <div class="iluk-agent"><img src="/brand/iluk-agent-collect.webp" alt="" width="292" height="388" loading="lazy" decoding="async" /><span>collect</span></div>
          </div>
          <div class="system-rail" aria-hidden="true">{Array.from({length:5},()=> <span class="rail-dot"></span>)}</div>
          <ol class="system-nodes"><li>{t('work.iluk.node1')}</li><li>{t('work.iluk.node2')}</li><li>{t('work.iluk.node3')}</li><li>{t('work.iluk.node4')}</li><li>{t('work.iluk.node5')}</li></ol>
          <div class="system-human label"><span aria-hidden="true">↳</span> {t('work.iluk.human')}</div>
        </figure>
        <div class="project-copy"><p class="label project-role">{t('work.iluk.role')}</p><h3>{t('work.iluk.title')}</h3><p class="project-description">{t('work.iluk.body')}</p><dl class="project-metrics"><div><dt>100K+</dt><dd>{t('work.iluk.metric1')}</dd></div><div><dt>200+</dt><dd>{t('work.iluk.metric2')}</dd></div></dl><a class="metric-source" href="https://www.linkedin.com/in/luisced/" target="_blank" rel="noopener">{t('work.iluk.source')} ↗</a><a class="btn" href="https://www.iluk.ai/" target="_blank" rel="noopener">{t('work.iluk.link')} <span aria-hidden="true">↗</span></a></div>
      </div>
    </article>
    {featured.map((p, i) => <article id={`project-${p.data.slug}`} class:list={['project', {'project--mobile': p.data.category === 'ios'}]} data-chapter>
      <div class="project-top label"><span>[0{i + 2}] / {p.data.title.split(' / ')[0]}</span><span>{t(`work.category.${p.data.category}`)} / {p.data.timeframe}</span></div>
      <div class="project-layout">
        <a class="project-image" href={localizePath(locale, `/work/${p.data.slug}/`)} aria-label={`${t('work.view')}: ${p.data.title}`}>
          <Picture fallbackFormat="webp" src={p.data.gallery[0]?.src ?? p.data.cover} alt={p.data.gallery[0]?.alt ?? p.data.coverAlt} widths={p.data.category === 'ios' ? [320,480,640] : [480,800,1200]} sizes={p.data.category === 'ios' ? '(min-width: 64em) 250px, 42vw' : '(min-width: 64em) 56vw, 90vw'} formats={['avif','webp']} loading="lazy" />
          <span class="image-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="M4 16 16 4M4 4h12v12"/></svg></span>
        </a>
        <div class="project-copy"><p class="label project-role">{p.data.role}</p><h3><a href={localizePath(locale, `/work/${p.data.slug}/`)}>{p.data.title}</a></h3><p class="project-description">{p.data.outcome}</p><p class="project-stack">{p.data.stack.map(s => <span class="chip">{s}</span>)}</p><a class="btn" href={localizePath(locale, `/work/${p.data.slug}/`)}>{t('work.view')} <span aria-hidden="true">↗</span></a></div>
      </div>
    </article>)}
  </div>
</section>
<style>
  #work { border-top: 0; }
  .work-heading { padding-bottom: 3rem; }
  .work-heading h2 { font-size: clamp(3.25rem, 8.2vw, 8.5rem); margin-block: 2rem; font-weight: 650; max-width: 13ch; }
  .work-intro { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; align-items: end; }
  .work-intro p { max-width: 42ch; color: var(--fg-2); }
  .chapters { display: flex; overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: none; border: 1px solid var(--line); background: var(--bg); }
  .chapters::-webkit-scrollbar { display: none; }
  .chapters a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; flex: 1 0 10rem; min-height: 4.25rem; padding: .8rem 1rem; gap: .65rem; border-left: 1px solid var(--line); text-decoration: none; font-size: .7rem; }
  .chapters a:first-child { border-left: 0; }
  .chapters a > span:first-child { font: .55rem var(--font-mono); color: var(--fg-3); }
  .chapters a > span:last-child { justify-self: end; font-size: 1.1rem; line-height: 1; }
  .chapters a[aria-current] { background: var(--fg); color: var(--bg); }
  .chapters a[aria-current] > span:first-child { color: var(--pink); }
  .project { margin-top: 2rem; border: 1px solid var(--line); scroll-margin-top: 9rem; }
  .project-top { display: flex; justify-content: space-between; gap: 1.5rem; padding: 1rem; border-bottom: 1px solid var(--line); font-size: .6rem; }
  .project-layout { display: grid; }
  .project-layout > * { min-width: 0; }
  .project-copy { padding: 2rem 1.25rem; }
  .project h3 { font-size: clamp(2rem, 3.4vw, 3.75rem); max-width: 17ch; line-height: 1.02; margin-top: 1.5rem; }
  .project h3 a { text-decoration: none; }
  .project-role { font-size: .6rem; }
  .project-description { max-width: 45ch; font-size: 1rem; line-height: 1.65; color: var(--fg-2); margin-top: 1.5rem; }
  .project-image { width: 100%; display: grid; position: relative; place-items: center; padding: clamp(1.5rem,4vw,4rem); min-height: 19rem; background: #dfdfd8; overflow: hidden; isolation: isolate; }
  .project-image::before { content: ''; position: absolute; inset: 0; z-index: -1; background-position: center; background-size: cover; opacity: .9; filter: saturate(.7); }
  .project-image :global(picture) { width: 100%; position: relative; z-index: 1; }
  .project-image :global(img) { width: 100%; object-fit: contain; filter: drop-shadow(0 12px 15px #17171718); }
  .project--mobile .project-image { background: #e7bad0; }
  .project--mobile .project-image::before { background-image: url('/brand/upocket-backdrop.webp'); }
  .project--mobile .project-image :global(picture) { width: 45%; max-width: 15.5rem; }
  .project--mobile .project-image :global(img) { max-height: 33rem; }
  .project:last-child .project-image { background: #c9d4c4; }
  .project:last-child .project-image::before { background-image: url('/brand/genesis-backdrop.webp'); }
  .image-arrow { position: absolute; right: 0; top: 0; display: grid; place-items: center; width: 3rem; height: 3rem; border-bottom: 1px solid #8e8e84; border-left: 1px solid #8e8e84; color: #171717; }
  .system-figure { position: relative; display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem,3vw,3rem); background: #171717; color: #f7f7f2; min-height: 24rem; --figure-accent: var(--pink); --figure-line: #7c7c73; }
  .system-figure .label { color: #c5c5bc; font-size: .6rem; }
  .doppie-swarm { position: absolute; right: 1.5rem; bottom: 6.7rem; display: flex; align-items: end; gap: .15rem; height: 8.5rem; pointer-events: none; }
  .doppie { width: 4.8rem; height: 4.8rem; object-fit: contain; object-position: bottom; filter: drop-shadow(0 5px 0 rgba(25,25,20,.12)); animation: doppie-float 3.6s ease-in-out infinite; }
  .doppie--reviewer { width: 6rem; height: 6rem; animation-delay: -.5s; }
  .doppie--producer { animation-delay: -1.7s; }
  .doppie--creator { width: 5.3rem; height: 5.3rem; animation-delay: -2.5s; }
  .iluk-agents { display: flex; align-items: end; justify-content: center; gap: clamp(.6rem, 2vw, 1.5rem); min-height: 8.5rem; margin: -1rem 0 1.5rem; color: #4a1fff; }
  .iluk-agent { display: grid; justify-items: center; gap: .2rem; width: clamp(3.7rem, 9vw, 6.5rem); font: .48rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: #514c67; }
  .iluk-agent img { display: block; width: 100%; height: auto; filter: drop-shadow(0 4px 0 rgba(74,31,255,.1)); }
  .iluk-agent--raised { transform: translateY(-.9rem); }
  @keyframes doppie-float { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-.4rem) rotate(2deg); } }
  @media (--motion-reduce) { .doppie { animation: none; } }
  .system-figure--dopamina { color: #191914; background: radial-gradient(circle at 89% 18%, rgba(244,201,78,.95) 0 2px, transparent 3px), radial-gradient(circle at 82% 25%, rgba(242,106,79,.65) 0 1px, transparent 2px), #f4f0e8; --figure-accent: #f26a4f; --figure-line: #b9ae9e; }
  .system-figure--dopamina .label { color: #6e665c; }
  .system-figure--iluk { position: relative; overflow: hidden; min-height: 20rem; background: #f6f3ff; color: #12101d; --figure-accent: #4a1fff; --figure-line: #b7acd9; }
  .system-figure--iluk::after { content: ''; position: absolute; inset: 0 0 0 auto; width: 6%; background: #4a1fff; clip-path: polygon(42% 0, 100% 0, 100% 100%, 0 100%); }
  .system-figure--iluk > * { position: relative; z-index: 1; }
  .system-figure--iluk .label { color: #514c67; }
  .brand-lockup { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: clamp(7rem,13vw,13rem); margin-block: 2rem 3rem; }
  .brand-lockup img { display: block; height: auto; object-fit: contain; object-position: left center; }
  .brand-lockup--dopamina img { width: min(80%, 32rem); }
  .brand-lockup--iluk { min-height: clamp(6rem,10vw,10rem); margin-block: 1.5rem 2rem; padding-right: 3rem; }
  .brand-lockup--iluk img { width: min(52%, 16rem); padding: 0; background: transparent; mix-blend-mode: normal; }
  .brand-signal { display: grid; place-items: center; flex: 0 0 3.5rem; width: 3.5rem; height: 3.5rem; border: 1px solid var(--figure-accent); border-radius: 50%; color: var(--figure-accent); font-size: 1.4rem; }
  .system-rail { position: relative; display: flex; justify-content: space-around; align-items: center; height: 1rem; }
  .system-rail::before { content: ''; position: absolute; height: 1px; width: 80%; left: 10%; background: var(--figure-line); }
  .rail-dot { width: 7px; height: 7px; border: 1px solid var(--figure-accent); background: transparent; z-index: 1; }
  .system-nodes { list-style: none; padding: .75rem 0 2rem; display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); text-align: center; gap: .25rem; font-size: clamp(.5rem,1vw,.7rem); }
  .system-human { display: flex; gap: 1rem; border-top: 1px solid var(--figure-line); padding-top: 1rem; }
  .system-human > span { color: var(--figure-accent); }
  .project-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; border-block: 1px solid var(--line); padding-block: 1rem; margin-top: 1.5rem; }
  .project-metrics dt { font-size: 2.6rem; letter-spacing: -.065em; line-height: 1.3; }
  @media (--md) { .chapters a { flex-basis: 0; padding-inline: 1.25rem; } }
  .metric-source { display: block; margin-top: .75rem; font-size: .6rem; color: var(--fg-3); }
  @media (--lg) { .chapters { position: sticky; top: 5.25rem; z-index: 5; } .project-layout { grid-template-columns: 1.3fr 1fr; } .project-copy { padding: 3rem; } .project-image { min-height: 38rem; } .project--mobile .project-image { min-height: 40rem; } .project-top { padding-inline: 1.5rem; } }
  @media (--pointer) { .project-image :global(picture) { transition: transform .4s; } .project-image:hover :global(picture) { transform: scale(1.025); } }
  @media (--motion-reduce) { .project-image :global(picture) { transition: none; } }
  @supports (animation-timeline: view()) { @media (--motion-ok) { .project--current { view-timeline: --workflow block; } .system-rail::after { content: ''; position: absolute; width: 80%; left: 10%; height: 1px; background: var(--pink); transform-origin: left; animation: trace linear both; animation-timeline: --workflow; animation-range: entry 30% cover 70%; } @keyframes trace { from { transform: scaleX(0); } to { transform: scaleX(1); } } } }
</style>
