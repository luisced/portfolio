---
import { getProfile, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import HeroCloud from '@/components/HeroCloud.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const { data: p } = await getProfile();
// A build-time wireframe sculpture. No canvas, downloaded video or client renderer.
const point = (u: number, v: number) => {
  const x = (220 + 83 * Math.cos(v)) * Math.cos(u);
  const y = (220 + 83 * Math.cos(v)) * Math.sin(u) * .58 - 83 * Math.sin(v) * .82;
  const a = -.48;
  return `${(360 + x * Math.cos(a) - y * Math.sin(a)).toFixed(1)},${(360 + x * Math.sin(a) + y * Math.cos(a)).toFixed(1)}`;
};
const parallels = Array.from({ length: 18 }, (_, i) => Array.from({ length: 81 }, (_, j) => `${j ? 'L' : 'M'}${point(j / 80 * Math.PI * 2, i / 18 * Math.PI * 2)}`).join('') + 'Z');
const meridians = Array.from({ length: 32 }, (_, i) => Array.from({ length: 33 }, (_, j) => `${j ? 'L' : 'M'}${point(i / 32 * Math.PI * 2, j / 32 * Math.PI * 2)}`).join('') + 'Z');
const principles = [
  { title: t('hero.principle1'), body: t('hero.principle1.body'), link: 'UPocket', href: '#project-upocket' },
  { title: t('hero.principle2'), body: t('hero.principle2.body'), link: 'Flowlink', href: '#project-stackup-channel-manager' },
  { title: t('hero.principle3'), body: t('hero.principle3.body'), link: 'Dopamina', href: '#project-dopamina' },
];
---
<section id="hero" class="hero container" aria-labelledby="hero-title">
  <div class="hero-register label"><span>{p.headline[locale]}</span><span>{p.location} / UTC−6</span></div>
  <div class="hero-stage">
    <HeroCloud />
    <div class="hero-copy">
      <p class="hero-byline label">{t('hero.byline')}</p>
      <h1 id="hero-title"><span class="sr-only">Luis Cedillo: </span><span>{t('hero.line1')}</span>{' '}<span>{t('hero.line2')}</span></h1>
      <p class="hero-description">{p.positioning[locale]}</p>
      <div class="hero-actions"><a class="btn btn--primary" href="#work">{t('hero.cta.work')} <span aria-hidden="true">↗</span></a><a class="text-link" href="#contact">{t('hero.cta.contact')} <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-coordinate label">LC / FIG. 001</div>
      <svg class="sculpture" viewBox="0 0 720 720" fill="none" stroke="currentColor" stroke-width=".8">
        <g class="wireframe">{parallels.map((d, i) => <path d={d} pathLength="1" style={`--draw-delay: ${i * 22}ms`}/>)}{meridians.map((d, i) => <path d={d} pathLength="1" style={`--draw-delay: ${180 + i * 22}ms`}/>)}</g>
        <path class="crosshair" d="M32 48h32m-16-16v32M656 656h32m-16-16v32" stroke-width="1"/>
      </svg>
      <div class="art-caption label"><span>{t('hero.diagram')}</span><span>[∞]</span></div>
    </div>
    <a class="current-window" href="https://dopamina.media/" target="_blank" rel="noopener"><span class="window-bar label">{t('hero.now')} <span aria-hidden="true">↗</span></span><span class="window-body"><span class="status-dot" aria-hidden="true"></span>{t('hero.current')}</span></a>
  </div>
  <div class="hero-bottom label"><span>01 / {t('hero.disciplines')}</span><a href="#approach">{t('hero.scroll')} <span aria-hidden="true">↓</span></a></div>
</section>
<section id="approach" class="approach container" aria-labelledby="approach-title">
  <div class="approach-header"><p class="label">{t('hero.approach.label')}</p><span class="approach-symbol" aria-hidden="true">✳</span></div>
  <h2 id="approach-title">{t('hero.approach.line1')}<br/><span>{t('hero.approach.line2')}</span></h2>
  <div class="principles">{principles.map((item, i) => <article data-reveal><p class="label">[0{i + 1}]</p><h3>{item.title}</h3><p>{item.body}</p><a class="text-link" href={item.href}>{item.link} <span aria-hidden="true">↗</span></a></article>)}</div>
  <div class="approach-foot label"><span>{t('hero.approach.foot')}</span><span aria-hidden="true">↓ ↓ ↓</span></div>
</section>
<script>
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  const art = stage?.querySelector<HTMLElement>('.hero-art');
  const sculpture = art?.querySelector<SVGSVGElement>('.sculpture');
  if (stage && art && sculpture) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const mouse = matchMedia('(hover: hover) and (pointer: fine)');
    let visible = false;
    let built = false;
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;

    function build() {
      if (built || !visible || reduced.matches) return;
      built = true;
      art!.classList.add('is-building');
      observer.disconnect();
    }
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry!.isIntersecting && entry!.intersectionRatio >= .35;
      build();
    }, { threshold: .35 });
    observer.observe(art);
    art.querySelector('.wireframe path:last-child')?.addEventListener('animationend', () => {
      art.classList.remove('is-building');
    });

    function resetTilt() {
      cancelAnimationFrame(frame);
      frame = 0;
      sculpture!.style.setProperty('--tilt-x', '0deg');
      sculpture!.style.setProperty('--tilt-y', '0deg');
    }
    function tilt() {
      frame = 0;
      const rect = art!.getBoundingClientRect();
      const x = (pointerX - rect.left) / rect.width;
      const y = (pointerY - rect.top) / rect.height;
      if (x < 0 || x > 1 || y < 0 || y > 1) return resetTilt();
      sculpture!.style.setProperty('--tilt-x', `${(0.5 - y) * 8}deg`);
      sculpture!.style.setProperty('--tilt-y', `${(x - 0.5) * 12}deg`);
    }
    stage.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || reduced.matches || !mouse.matches) return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = requestAnimationFrame(tilt);
    }, { passive: true });
    stage.addEventListener('pointerleave', resetTilt);
    window.addEventListener('blur', resetTilt);
    mouse.addEventListener('change', resetTilt);
    reduced.addEventListener('change', () => {
      resetTilt();
      if (reduced.matches) art.classList.remove('is-building');
      else build();
    });
  }
</script>
<style>
  .hero { border: 1px solid var(--line); border-top: 0; }
  .hero-register { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 2rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); font-size: .6rem; }
  .hero-stage { position: relative; isolation: isolate; padding: 2.5rem 1.25rem 1.5rem; overflow: clip; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-byline { margin-bottom: 1.5rem; font-size: .65rem; }
  h1 { font-size: clamp(2rem, 12.4vw, 5.75rem); font-weight: 750; line-height: .88; letter-spacing: -.075em; text-transform: uppercase; }
  h1 > span:not(.sr-only) { display: block; white-space: nowrap; }
  .hero-description { max-width: 37ch; margin-top: 2rem; font-size: 1rem; line-height: 1.6; color: var(--fg-2); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-top: 1.75rem; }
  .hero-actions .btn { gap: 2rem; }
  .hero-actions .text-link { gap: .5rem; }
  .hero-art { position: relative; margin: 1rem -.5rem 0; }
  .sculpture { width: 100%; height: auto; aspect-ratio: 1.25; overflow: visible; }
  .art-coordinate { position: absolute; top: 1.5rem; left: 1.25rem; font-size: .55rem; }
  .art-caption { display: flex; justify-content: space-between; margin: -1.5rem 1.25rem 1rem; font-size: .55rem; }
  .current-window { display: block; position: relative; width: fit-content; min-width: 15rem; max-width: 100%; border: 1px solid var(--fg); box-shadow: 3px 3px 0 var(--line); background: var(--bg); text-decoration: none; margin-top: 1.5rem; }
  .window-bar { display: flex; justify-content: space-between; padding: .25rem .5rem; background: var(--fg); color: var(--bg); font-size: .55rem; }
  .window-body { display: flex; align-items: center; gap: .6rem; font: .65rem var(--font-mono); padding: .8rem .65rem; }
  .status-dot { width: 6px; height: 6px; background: var(--fg); }
  .current-window:hover { background: var(--pink); color: #171717; }
  .hero-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-top: 1px solid var(--line); font-size: .55rem; }
  .hero-bottom a { display: flex; align-items: center; gap: 2rem; min-height: 2rem; }
  .approach { position: relative; border: 1px solid #171717; border-top: 0; background: var(--pink); color: #171717; padding: 1.5rem 1.25rem 0; --fg: #171717; --fg-2: #383234; --fg-3: #383234; --line: #9c647a; --accent: #171717; }
  .approach-header { display: flex; justify-content: space-between; align-items: center; }
  .approach-symbol { font-size: 2.75rem; line-height: 1; }
  .approach h2 { font-size: clamp(2.75rem, 7.1vw, 7.5rem); line-height: .98; letter-spacing: -.065em; margin-block: 3rem; font-weight: 650; }
  .approach h2 > span { font-weight: 400; }
  .principles { display: grid; border-top: 1px solid var(--line); }
  .principles article { padding-block: 2rem; border-bottom: 1px solid var(--line); }
  .principles h3 { font-size: 1.65rem; max-width: 14ch; margin-block: 1rem; font-weight: 600; }
  .principles article > p:not(.label) { max-width: 35ch; font-size: .9rem; line-height: 1.6; }
  .principles .text-link { margin-top: .5rem; font-family: var(--font-mono); font-size: .65rem; }
  .approach-foot { display: flex; justify-content: space-between; gap: 1.5rem; padding-block: 1rem; font-size: .55rem; }
  @media (--md) {
    .hero-register, .hero-bottom { padding-inline: 2rem; }
    .hero-stage { min-height: min(46rem, 79svh); padding: 5rem 2rem 3.5rem; display: flex; align-items: center; }
    .hero-copy { width: 72%; }
    h1 { font-size: clamp(4rem, 9.6vw, 10rem); }
    .hero-description { max-width: 34ch; margin-top: 2.5rem; }
    .hero-art { position: absolute; right: -5%; top: 12%; width: 50%; margin: 0; z-index: -1; }
    .sculpture { aspect-ratio: 1; }
    .art-caption { margin-top: -3rem; }
    .current-window { position: absolute; right: 2.5rem; top: 2rem; margin: 0; }
    .approach { padding-inline: 2rem; }
    .principles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .principles article { border-bottom: 0; padding: 2rem; }
    .principles article:first-child { padding-left: 0; }
    .principles article + article { border-left: 1px solid var(--line); }
    .principles article:last-child { padding-right: 0; }
    .approach-foot { border-top: 1px solid var(--line); }
  }
  @media (--lg) { .hero-stage { padding-block: 6rem 4rem; } .hero-art { top: 1%; right: -3%; width: 49%; } }
  @media (--motion-ok) {
    .is-building .wireframe path { stroke-dasharray: 1; animation: construct-ring 1.15s cubic-bezier(.22,.61,.36,1) var(--draw-delay) both; }
    .sculpture { transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transition: transform .45s ease-out; }
    @keyframes construct-ring { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @supports (animation-timeline: view()) {
      .hero { view-timeline: --hero block; }
      .hero-art { animation: sculpture-scroll linear both; animation-timeline: --hero; animation-range: exit 0% exit 100%; }
      @keyframes sculpture-scroll { to { transform: translateY(15%) rotate(18deg); } }
      .approach { view-timeline: --approach block; }
      .approach-symbol { animation: symbol-turn linear both; animation-timeline: --approach; animation-range: entry 0% exit 100%; }
      @keyframes symbol-turn { to { transform: rotate(180deg); } }
    }
  }
</style>
