---
import { Picture } from 'astro:assets';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import type { Project } from '@/i18n/utils';

interface Props {
  project: Project;
  locale: Locale;
  index: number;
  sizes?: string;
  featured?: boolean;
}

const {
  project,
  locale,
  index,
  sizes = '100vw',
  featured = false,
} = Astro.props;
const t = useTranslations(locale);
const categoryLabel = t(`work.category.${project.data.category}`);
const projectIndex = String(index + 1).padStart(2, '0');
const visibleStack = project.data.stack.slice(0, 4);
const href = localizePath(locale, `/work/${project.data.slug}/`);
---

<a
  class:list={['project-card', { 'project-card--featured': featured }]}
  href={href}
  data-reveal
>
  <div class="project-card__meta">
    <span class="project-card__index mono" aria-hidden="true">{projectIndex}</span>
  </div>

  <div class="project-card__frame">
    <Picture
      fallbackFormat="webp"
      src={project.data.cover}
      alt={project.data.coverAlt}
      widths={[480, 800, 1200]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading="lazy"
    />
  </div>

  <div class="project-card__body">
    <span class:list={['project-card__category', `project-card__category--${project.data.category}`]}>
      {categoryLabel}
    </span>
    <h3 class="display project-card__title">{project.data.title}</h3>
    <p class="project-card__outcome">{project.data.outcome}</p>
    <p class="mono project-card__role">{project.data.role}</p>

    <ul class="project-card__stack" aria-label={t('work.stack')}>
      {visibleStack.map((item) => <li>{item}</li>)}
    </ul>

    <span class="project-card__cta">
      {t('work.view')} <span aria-hidden="true">↗</span>
    </span>
  </div>
</a>

<style>
  .project-card {
    position: relative;
    display: grid;
    /* index / frame / body — the frame row absorbs any extra height (featured span). */
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    gap: var(--s-3);
    padding: var(--s-3);
    overflow: clip;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    background: var(--bg-2);
    color: var(--fg);
    text-decoration: none;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--d-2) var(--ease-out),
      border-color var(--d-2) var(--ease-out),
      box-shadow var(--d-2) var(--ease-out);
  }

  .project-card::before {
    position: absolute;
    inset: 0 var(--s-3) auto;
    height: 1px;
    content: '';
    background: var(--rim);
    pointer-events: none;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: var(--s-7);
  }

  .project-card__index {
    color: var(--fg-3);
    font-size: var(--text-xs);
  }

  .project-card__category {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .project-card__category::before {
    width: 0.375rem;
    height: 0.375rem;
    flex: 0 0 auto;
    border-radius: 50%;
    content: '';
    background: var(--project-accent);
  }

  .project-card__category--ios {
    --project-accent: var(--accent-violet);
  }

  .project-card__category--web {
    --project-accent: var(--accent-brand);
  }

  .project-card__category--backend {
    --project-accent: var(--accent-amber);
  }

  .project-card__frame {
    display: grid;
    padding: var(--s-2);
    border: 1px solid var(--line-2);
    border-radius: var(--r-2);
    background: var(--bg-3);
    box-shadow: inset 0 1px 0 var(--rim), var(--shadow-1);
  }

  .project-card__frame :global(picture) {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--r-1);
  }

  .project-card__frame :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-card__body {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-2) var(--s-1);
  }

  .project-card__title {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .project-card__outcome {
    max-width: 38ch;
    color: var(--fg-2);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .project-card__role {
    color: var(--fg-3);
    font-size: var(--text-xs);
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .project-card__stack li {
    padding: var(--s-1) var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.2;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    width: fit-content;
    margin-top: var(--s-2);
    border-bottom: 1px solid var(--brand);
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    line-height: var(--leading-snug);
  }

  @media (--lg) {
    .project-card--featured {
      grid-column: span 2;
      grid-row: span 2;
    }

    .project-card--featured .project-card__frame :global(picture) {
      height: 100%;
    }

    .project-card--featured .project-card__frame :global(img) {
      aspect-ratio: auto;
      height: 100%;
      min-height: 18rem;
    }
  }

  @media (--pointer) {
    .project-card:hover {
      transform: translateY(-2px);
      border-color: var(--fg-3);
      box-shadow: var(--shadow-2);
    }

    .project-card:hover .project-card__cta {
      border-color: var(--fg);
      color: var(--fg);
    }
  }
</style>
