{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/es/index.html",
        "http://localhost/work/stackup-channel-manager/index.html",
        "http://localhost/notes/channel-sync-partial-failures/index.html"
      ],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true } }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "color-contrast": "error",
        "font-display": "error",
        "unsized-images": "error",
        "uses-responsive-images": "warn"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  },
  "_notes": [
    "The editorial design uses static Astro HTML, native scroll-linked CSS and small IntersectionObserver enhancements. Keep performance and blocking-time gates enabled.",
    "All raster images have intrinsic dimensions. Local fonts use swap; CLS remains gated at 0.02 across environments.",
    "Landing JS (including inline modules, ≤ 60 KB gz), font count (≤ 4) and image sizes are enforced by scripts/check-assets.mjs at build time."
  ]
}
