---
// Unknown addresses land here instead of on the home page.
import site from '../content/site.json';
import '../styles/fonts.css';
import '../styles/case.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0910">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>Page not found — {site.shortName}</title>
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml">
</head>
<body>
<main class="case">
  <p class="label">404</p>
  <h1>This page isn't in the room.</h1>
  <p class="outcome">Esta página no está en el cuarto.</p>
  <p class="links" style="margin-top:40px"><a class="btn primary" href={import.meta.env.BASE_URL}>Back to the portfolio <span aria-hidden="true">→</span></a><a class="btn" href={`${import.meta.env.BASE_URL}es/`}>Volver al portafolio <span aria-hidden="true">→</span></a></p>
</main>
</body>
</html>
