---
// Email and social links, each with its icon: written on the floor at the end, and in the no-3D fallback.
import { siGithub } from 'simple-icons';
import site from '../content/site.json';

/* simple-icons carries no LinkedIn mark, and a plain envelope is not a brand: both are drawn here on the same 24px grid */
const MAIL = 'M2 5h20v14H2V5zm2 2v.5l8 5.2 8-5.2V7H4zm16 2.9-8 5.2-8-5.2V17h16V9.9z';
const LINKEDIN = 'M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm2.5 7.2V18h2.7V9.2H6.5zm1.35-4.3a1.57 1.57 0 1 0 0 3.14 1.57 1.57 0 0 0 0-3.14zM11 9.2V18h2.7v-4.6c0-1.3.6-2 1.6-2s1.4.7 1.4 2V18h2.7v-5.3c0-2.4-1.3-3.7-3.2-3.7-1.2 0-2 .5-2.5 1.2V9.2H11z';
const paths: Record<string, string> = { GitHub: siGithub.path, LinkedIn: LINKEDIN };
---
<a href={`mailto:${site.email}`}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d={MAIL} /></svg>{site.email}</a>{site.socials.map((s) => <Fragment> · <a href={s.url} rel="me noopener">{paths[s.label] && <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d={paths[s.label]} /></svg>}{s.label}</a></Fragment>)}
