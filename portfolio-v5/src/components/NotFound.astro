---
// The 404: the room with the lights off, the terminal that could not find the path, and the duck asking the obvious question.
import site from '../content/site.json';
import { poster as makePoster } from '../lib/room.mjs';
import { localizePath, type Locale } from '../lib/projects';
import '../styles/fonts.css';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = site.locales[lang], l = t.lost;
const poster = makePoster();
const other: Locale = lang === 'en' ? 'es' : 'en';
const home = localizePath(lang, '/');
const shortcuts = [['about', t.nav.about], ['work', t.nav.work], ['experience', t.nav.experience], ['stack', t.nav.stack], ['awards', t.nav.awards], ['contact', t.nav.contact]] as const;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#08060d">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>{l.title} — {site.shortName}</title>
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml">
</head>
<body>
<header class="bar">
  <a class="brand" href={home}>{site.shortName}</a>
  <a class="lang" href={localizePath(other, '/')} hreflang={other} lang={other}>{t.other}</a>
</header>

<main>
  <div class="copy">
    <p class="k">{l.kicker}</p>
    <h1>{l.head}</h1>
    <p class="body">{l.body}</p>

    <!-- the terminal that looked for the page -->
    <div class="term" role="img" aria-label={`cd: ${l.noFile}`}>
      <p><span>$</span> cd <b id="path">/…</b></p>
      <p class="err">cd: {l.noFile}<i class="caret short"></i></p>
      <p class="more"><span>$</span> git status</p>
      <p class="dim more">HEAD → {site.shortName.toLowerCase().replace(' ', '-')}/main<i class="caret"></i></p>
    </div>

    <a class="go" href={home}>{l.home} <span aria-hidden="true">→</span></a>

    <nav aria-label={l.try}>
      <p class="k dim">{l.try}</p>
      <ul>
        {shortcuts.map(([k, name], i) => <li><a href={`${home}#${k}`}><span>{String(i + 1).padStart(2, '0')}</span>{name}</a></li>)}
        <li><a href={localizePath(lang, '/recognition/#work')}><span>07</span>{t.allWork}</a></li>
      </ul>
    </nav>
  </div>

  <!-- the room, lights off; the duck is the only one awake -->
  <figure class="room">
    <img src={poster.uri} alt="" width={poster.side} height={poster.side} decoding="async">
    <figcaption class="duck"><span class="num" aria-hidden="true">404</span>{l.duck}</figcaption>
  </figure>
</main>

<script is:inline>
  /* show the address that was asked for, trimmed so it never breaks the terminal */
  (function () {
    var p = decodeURIComponent(location.pathname || '/');
    document.getElementById('path').textContent = p.length > 34 ? p.slice(0, 16) + '…' + p.slice(-16) : p;
  })();
</script>

<style>
  :root { --bg: #08060d; --fg: #f4f1ea; --soft: rgba(244, 241, 234, .68); --line: rgba(244, 241, 234, .16); --accent: #ffc46b;
    --sans: 'Archivo Variable', system-ui, -apple-system, 'Segoe UI', sans-serif; --mono: 'Azeret Mono', ui-monospace, Menlo, Consolas, monospace;
    --pad: clamp(20px, 5vw, 72px); }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
  /* everything fits one screen: sizes follow the viewport's height as well as its width, and the least essential lines drop out first */
  body { margin: 0; min-height: 100svh; display: grid; grid-template-rows: auto 1fr; background: radial-gradient(ellipse at 72% 52%, #15111f 0%, #08060d 60%); color: var(--fg); font: 400 clamp(15px, 2.1svh, 17px)/1.5 var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; touch-action: manipulation; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .bar { display: flex; justify-content: space-between; align-items: center; padding: calc(clamp(4px, 1svh, 12px) + env(safe-area-inset-top, 0px)) calc(var(--pad) + env(safe-area-inset-right, 0px)) clamp(4px, 1svh, 12px) calc(var(--pad) + env(safe-area-inset-left, 0px)); }
  .brand { display: flex; align-items: center; gap: 10px; padding: 12px 0; font: 750 15px/1 var(--sans); letter-spacing: -.02em; text-transform: uppercase; text-decoration: none; }
  .brand::before { content: ''; width: 8px; height: 8px; background: var(--accent); }
  .lang { padding: 12px 0; font: 400 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; text-decoration: none; color: var(--soft); }

  main { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; gap: clamp(24px, 5vw, 80px); max-width: 1240px; width: 100%; margin: 0 auto; padding: clamp(4px, 2svh, 28px) calc(var(--pad) + env(safe-area-inset-right, 0px)) calc(clamp(12px, 4svh, 44px) + env(safe-area-inset-bottom, 0px)) calc(var(--pad) + env(safe-area-inset-left, 0px)); }
  .k { margin: 0; font: 400 12px/1.5 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .k.dim { color: var(--soft); }
  h1 { margin: clamp(6px, 1.2svh, 12px) 0 clamp(8px, 1.8svh, 16px); font: 700 clamp(30px, min(5.4vw, 8.2svh), 76px)/.93 var(--sans); letter-spacing: -.055em; text-wrap: balance; }
  .body { margin: 0; max-width: 32em; color: var(--soft); text-wrap: pretty; }

  .term { margin: clamp(12px, 2.6svh, 26px) 0; padding: clamp(10px, 1.8svh, 16px) 18px; max-width: 30em; background: #0e1a2e; color: #d6e6ff; font: 400 13.5px/1.7 var(--mono); box-shadow: 0 0 60px 6px rgba(84, 132, 255, .14); overflow: hidden; }
  .term p { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .term span { color: var(--accent); }
  .term b { font-weight: 400; color: #f4f1ea; }
  .term .err { color: #ffa094; }
  .term .dim { color: rgba(214, 230, 255, .6); }
  .caret { display: inline-block; width: .55em; height: 1em; margin-left: 4px; vertical-align: -.14em; background: var(--accent); animation: caret .9s steps(1) infinite; }
  .caret.short { display: none; }
  @keyframes caret { 50% { opacity: 0; } }

  .go { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 48px; padding: 0 20px; background: var(--accent); color: #17110a; font: 400 12px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; transition: scale .12s ease-out, background .15s; }
  .go:active { scale: .97; background: var(--fg); }

  nav { margin-top: clamp(12px, 3svh, 30px); }
  nav ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 20px; max-width: 38em; margin: 8px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  nav a { display: flex; align-items: baseline; gap: 9px; padding: clamp(8px, 1.35svh, 12px) 0; border-bottom: 1px solid var(--line); font: 500 15px/1.2 var(--sans); letter-spacing: -.015em; text-decoration: none; white-space: nowrap; transition: color .15s; }
  nav a span { font: 400 10px/1 var(--mono); letter-spacing: .05em; color: rgba(244, 241, 234, .4); }
  nav a:active { color: var(--accent); }

  /* the room with the lights off: only what glows stays lit */
  .room { position: relative; margin: 0; justify-self: center; width: min(100%, 520px, 62svh); }
  .room img { display: block; width: 100%; height: auto; image-rendering: pixelated; filter: brightness(.42) saturate(.75) contrast(1.15); }
  .duck { position: absolute; left: 52%; top: 22%; max-width: 220px; padding: 10px 13px 11px; background: #f1eadc; color: #251a2c; font: 500 15px/1.25 var(--sans); letter-spacing: -.01em; text-wrap: balance; animation: bob 3.4s ease-in-out infinite; }
  .duck::after { content: ''; position: absolute; left: 22px; top: 100%; width: 12px; height: 8px; background: inherit; clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .duck .num { display: block; margin-bottom: 3px; font: 400 10px/1 var(--mono); letter-spacing: .08em; color: #8a5a12; }
  @keyframes bob { 50% { translate: 0 -5px; } }

  @media (hover: hover) and (pointer: fine) { nav a:hover, .lang:hover { color: var(--accent); } nav a:hover span { color: var(--accent); } .go:hover { background: var(--fg); } }
  /* short windows: the explanation goes first, then the second terminal command */
  @media (max-height: 640px) { .body { display: none; } }
  @media (max-height: 540px) { .term .more { display: none; } .caret.short { display: inline-block; } }
  /* phones: one column, the room on top and small; the list keeps two columns */
  @media (max-width: 860px) {
    main { grid-template-columns: minmax(0, 1fr); align-content: start; gap: 0; }
    .room { order: -1; width: min(60%, 23svh); margin-bottom: clamp(4px, 1.4svh, 14px); }
    .duck { left: 46%; top: 2%; width: max-content; max-width: 44vw; padding: 8px 11px 9px; font-size: 13.5px; }
    h1 { font-size: clamp(28px, min(9.4vw, 5.2svh), 44px); }
    .term .more { display: none; }
    .caret.short { display: inline-block; }
    .term { font-size: 13px; margin: clamp(10px, 2svh, 18px) 0; }
    nav { margin-top: clamp(10px, 2.2svh, 22px); }
    nav .k { display: none; }
    nav ul { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 0; }
    nav a { padding: clamp(7px, 1.25svh, 11px) 0; }
    nav li:last-child { display: none; } /* six shortcuts make three even rows */
  }
  @media (max-width: 860px) and (max-height: 740px) { .body { display: none; } }
  @media (prefers-reduced-motion: reduce) { .caret, .duck { animation: none; } }
</style>
</body>
</html>
